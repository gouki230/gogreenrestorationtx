---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

const title = 'Contact Go Green Restoration Inc | Free Estimates & 24/7 Emergency';
const description = 'Contact Go Green Restoration for free estimates and 24/7 emergency restoration services across the Dallas–Fort Worth metroplex. Call (469) 727-3217 or fill out our form.';
const breadcrumbs = [{ name: 'Home', url: '/' }, { name: 'Contact', url: '/contact/' }];

// Lead-form submission endpoint. Paste your form endpoint URL here to make the
// "Request a Free Estimate" form live (e.g. a GHL inbound webhook, Formspree
// https://formspree.io/f/XXXX, or Web3Forms https://api.web3forms.com/submit).
// While empty, the form shows a "call us" notice instead of submitting.
const FORM_ENDPOINT = '';
---

<BaseLayout title={title} description={description}>
  <Breadcrumbs items={breadcrumbs} />

  <section class="bg-gradient-to-br from-brand-brown to-brand-brown-dark text-white">
    <div class="max-w-7xl mx-auto px-4 py-16">
      <h1 class="font-heading text-4xl lg:text-5xl font-black mb-4">Contact Us</h1>
      <p class="text-lg text-brand-warm-200 max-w-3xl">Get a free estimate or reach our 24/7 emergency team. We respond to all inquiries within 1 hour.</p>
    </div>
  </section>

  <div class="max-w-7xl mx-auto px-4 py-12">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
      <!-- Get In Touch -->
      <div>
        <h2 class="font-heading text-2xl font-bold text-brand-gray-900 mb-6">Request a Free Estimate</h2>

        <form id="lead-form" action={FORM_ENDPOINT || undefined} method="POST" class="bg-white rounded-xl p-6 sm:p-8 border border-brand-warm-200 shadow-sm mb-8">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="lf-name" class="block text-sm font-medium text-brand-gray-700 mb-1">Full Name *</label>
              <input id="lf-name" name="name" type="text" required autocomplete="name" class="w-full rounded-lg border border-brand-gray-300 px-3 py-2.5 text-brand-gray-900 focus:border-brand-green focus:ring-2 focus:ring-brand-green/30 outline-none transition" />
            </div>
            <div>
              <label for="lf-phone" class="block text-sm font-medium text-brand-gray-700 mb-1">Phone *</label>
              <input id="lf-phone" name="phone" type="tel" required autocomplete="tel" class="w-full rounded-lg border border-brand-gray-300 px-3 py-2.5 text-brand-gray-900 focus:border-brand-green focus:ring-2 focus:ring-brand-green/30 outline-none transition" />
            </div>
            <div>
              <label for="lf-email" class="block text-sm font-medium text-brand-gray-700 mb-1">Email *</label>
              <input id="lf-email" name="email" type="email" required autocomplete="email" class="w-full rounded-lg border border-brand-gray-300 px-3 py-2.5 text-brand-gray-900 focus:border-brand-green focus:ring-2 focus:ring-brand-green/30 outline-none transition" />
            </div>
            <div>
              <label for="lf-service" class="block text-sm font-medium text-brand-gray-700 mb-1">Service Needed</label>
              <select id="lf-service" name="service" class="w-full rounded-lg border border-brand-gray-300 px-3 py-2.5 text-brand-gray-900 bg-white focus:border-brand-green focus:ring-2 focus:ring-brand-green/30 outline-none transition">
                <option value="">Select a service</option>
                <option>Water Damage Restoration</option>
                <option>Fire &amp; Smoke Damage</option>
                <option>Mold Cleanup</option>
                <option>Sewage Backup Cleanup</option>
                <option>Construction &amp; Remodeling</option>
                <option>Other / Not sure</option>
              </select>
            </div>
            <div class="sm:col-span-2">
              <label for="lf-city" class="block text-sm font-medium text-brand-gray-700 mb-1">Property City</label>
              <input id="lf-city" name="city" type="text" autocomplete="address-level2" placeholder="e.g. Plano, TX" class="w-full rounded-lg border border-brand-gray-300 px-3 py-2.5 text-brand-gray-900 focus:border-brand-green focus:ring-2 focus:ring-brand-green/30 outline-none transition" />
            </div>
            <div class="sm:col-span-2">
              <label for="lf-message" class="block text-sm font-medium text-brand-gray-700 mb-1">How can we help? *</label>
              <textarea id="lf-message" name="message" rows="4" required class="w-full rounded-lg border border-brand-gray-300 px-3 py-2.5 text-brand-gray-900 focus:border-brand-green focus:ring-2 focus:ring-brand-green/30 outline-none transition"></textarea>
            </div>
          </div>
          <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
          <input type="hidden" name="_subject" value="New estimate request — gogreenrestorationtx.com" />
          <button type="submit" id="lf-submit" class="mt-5 w-full bg-brand-green hover:bg-brand-green-light text-white font-bold uppercase tracking-wide text-sm px-6 py-3.5 rounded-lg transition-colors shadow-lg shadow-brand-green/30">Request Free Estimate</button>
          <p id="lf-status" class="mt-3 text-sm text-center" role="status" aria-live="polite"></p>
          <p class="mt-2 text-xs text-brand-gray-500 text-center">By submitting, you agree to be contacted about your request. We respond within one hour.</p>
        </form>

        <h3 class="font-heading text-lg font-bold text-brand-gray-900 mb-4">Prefer to reach us directly?</h3>
        <div class="bg-brand-warm rounded-xl p-8 border border-brand-warm-200">
          <p class="text-lg text-brand-gray-800 mb-6 leading-relaxed">
            Reach out to Go Green Restoration anytime — day or night. Our team responds to every inquiry within one hour. For active emergencies, please call us directly for the fastest response.
          </p>

          <div class="space-y-4">
            <a href="tel:+14697273217" class="flex items-center gap-4 bg-white rounded-lg p-4 border border-brand-warm-200 hover:border-brand-brown transition-colors group">
              <div class="w-12 h-12 rounded-full bg-brand-orange flex items-center justify-center flex-shrink-0">
                <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
              </div>
              <div>
                <p class="text-sm text-brand-gray-600">Call us 24/7</p>
                <p class="text-xl font-bold text-brand-brown group-hover:text-brand-orange transition-colors">(469) 727-3217</p>
              </div>
            </a>

            <a href="mailto:info@gogreenrestorationtx.com" class="flex items-center gap-4 bg-white rounded-lg p-4 border border-brand-warm-200 hover:border-brand-brown transition-colors group">
              <div class="w-12 h-12 rounded-full bg-brand-brown flex items-center justify-center flex-shrink-0">
                <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
              </div>
              <div>
                <p class="text-sm text-brand-gray-600">Email us</p>
                <p class="text-lg font-bold text-brand-brown group-hover:text-brand-orange transition-colors">info@gogreenrestorationtx.com</p>
              </div>
            </a>

            <a href="/emergency/" class="flex items-center gap-4 bg-white rounded-lg p-4 border border-brand-warm-200 hover:border-red-600 transition-colors group">
              <div class="w-12 h-12 rounded-full bg-red-600 flex items-center justify-center flex-shrink-0">
                <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4.5c-.77-.833-2.694-.833-3.464 0L3.34 16.5C2.57 17.333 3.532 19 5.072 19z"/></svg>
              </div>
              <div>
                <p class="text-sm text-brand-gray-600">Active emergency?</p>
                <p class="text-lg font-bold text-brand-gray-900 group-hover:text-red-600 transition-colors">Get help now &rarr;</p>
              </div>
            </a>
          </div>

          <p class="text-sm text-brand-gray-600 mt-6 text-center">
            You can also use the chat icon in the corner of any page — we'll get back to you fast.
          </p>
        </div>
      </div>

      <!-- Contact Info -->
      <div>
        <div class="bg-brand-brown text-white rounded-xl p-8 mb-6">
          <h2 class="font-heading text-2xl font-bold mb-4">24/7 Emergency Line</h2>
          <a href="tel:+14697273217" class="text-3xl font-bold text-brand-orange hover:text-brand-orange-light transition-colors block mb-4">(469) 727-3217</a>
          <p class="text-brand-warm-200">Our emergency team is available around the clock, 365 days a year. We typically arrive within 60 minutes of your call.</p>
        </div>

        <div class="bg-brand-gray-50 rounded-xl p-8 mb-6">
          <h2 class="font-heading text-xl font-bold text-brand-gray-900 mb-4">Company Information</h2>
          <div class="space-y-3 text-brand-gray-600">
            <p><strong>Go Green Restoration Inc</strong></p>
            <p>Bonded & Insured · IICRC- & EPA Lead-Safe certified</p>
            <p>IICRC Certified Technicians</p>
          </div>
        </div>

        <div class="bg-brand-gray-50 rounded-xl p-8 mb-6">
          <h2 class="font-heading text-xl font-bold text-brand-gray-900 mb-4">Our Locations</h2>
          <div class="space-y-4">
            <div>
              <h3 class="font-bold text-brand-gray-900 mb-1">Dallas-Fort Worth Office</h3>
              <p class="text-brand-gray-600 text-sm">1902 Parker Rd</p>
              <p class="text-brand-gray-600 text-sm">Wylie, TX 75098</p>
            </div>
          </div>
        </div>

        <div class="bg-brand-gray-50 rounded-xl p-8 mb-6">
          <h2 class="font-heading text-xl font-bold text-brand-gray-900 mb-4">Service Areas</h2>
          <div class="space-y-2 text-brand-gray-600">
            <p><a href="/locations/dfw-metro/" class="hover:text-brand-brown transition-colors">DFW Metro Area</a> — 88 cities + 40+ communities</p>
            <p><a href="/locations/dfw-metro/" class="hover:text-brand-brown transition-colors">DFW Metro Area</a> — 30 cities across 5 counties</p>
          </div>
        </div>

        <div class="bg-brand-gray-50 rounded-xl p-8">
          <h2 class="font-heading text-xl font-bold text-brand-gray-900 mb-4">Hours</h2>
          <div class="space-y-1 text-brand-gray-600 text-sm">
            <p class="flex justify-between"><span>Emergency Services:</span><strong>24/7/365</strong></p>
            <p class="flex justify-between"><span>Office Hours:</span><strong>Mon-Fri 8am-6pm</strong></p>
            <p class="flex justify-between"><span>Estimates:</span><strong>Mon-Sat 8am-6pm</strong></p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    const form = document.getElementById('lead-form');
    const statusEl = document.getElementById('lf-status');
    const btn = document.getElementById('lf-submit');
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const honey = form.querySelector('[name="_gotcha"]');
      if (honey && honey.value) return;
      const action = form.getAttribute('action');
      if (!action) {
        statusEl.textContent = 'Our online form is being set up — please call us at (469) 727-3217.';
        statusEl.className = 'mt-3 text-sm text-center text-brand-brown font-medium';
        return;
      }
      const original = btn.textContent;
      btn.disabled = true; btn.textContent = 'Sending…';
      statusEl.textContent = ''; statusEl.className = 'mt-3 text-sm text-center';
      try {
        const res = await fetch(action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
        if (!res.ok) throw new Error('Request failed');
        form.reset();
        statusEl.textContent = 'Thanks! Your request was sent — we’ll reach out within the hour.';
        statusEl.className = 'mt-3 text-sm text-center text-brand-green font-medium';
      } catch (err) {
        statusEl.textContent = 'Something went wrong. Please call us at (469) 727-3217.';
        statusEl.className = 'mt-3 text-sm text-center text-red-600 font-medium';
      } finally {
        btn.disabled = false; btn.textContent = original;
      }
    });
  </script>
</BaseLayout>
