---
import RealEstateLinks from '../../../components/RealEstateLinks.astro';
import { compactServiceUrl } from '../../../utils/compact-city-pages';
import { compactTopicsForArticle } from '../../../utils/compact-links';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import articles from '../../../data/blog-articles.json';
import indexingArticleOverrides from '../../../data/indexing-article-overrides.json';
import cities from '../../../data/cities-dfw-metro.json';

const clusterData: Record<string, { name: string; serviceSlug: string | null; serviceName: string | null }> = {
  'water-damage': { name: 'Water Damage', serviceSlug: 'water-damage-restoration', serviceName: 'Water Damage Restoration' },
  'fire-damage': { name: 'Fire & Smoke Damage', serviceSlug: 'fire-smoke-damage-restoration', serviceName: 'Fire & Smoke Damage Restoration' },
  'mold': { name: 'Mold', serviceSlug: 'mold-remediation', serviceName: 'Mold Remediation' },
  'sewage-plumbing': { name: 'Sewage & Plumbing', serviceSlug: 'sewage-backup-cleanup', serviceName: 'Sewage Backup & Cleanup' },
  'home-restoration': { name: 'Home Restoration', serviceSlug: 'construction-remodeling', serviceName: 'Construction & Remodeling' },
  'hoa-property-management': { name: 'HOA & Property Management', serviceSlug: null, serviceName: null },
};

export function getStaticPaths() {
  return articles.map((article) => ({
    params: { cluster: article.cluster, article: article.slug },
    props: { article: { ...article, ...(indexingArticleOverrides as Record<string, { description: string; content: string; image: string; imageAlt: string; imageGenerated: boolean }>)[article.slug] } },
  }));
}

const { article } = Astro.props;
const compactTopics = compactTopicsForArticle(article.slug);
const cluster = { slug: article.cluster, ...clusterData[article.cluster] };
const articleCity = [...cities].sort((a,b)=>b.slug.length-a.slug.length).find(c=>article.slug.endsWith(`-${c.slug}`));
const relatedArticles = articles.filter(a => a.cluster === article.cluster && a.slug !== article.slug).sort((a,b) => Number(Boolean(articleCity && b.slug.endsWith(`-${articleCity.slug}`))) - Number(Boolean(articleCity && a.slug.endsWith(`-${articleCity.slug}`)))).slice(0, 3);

const title = `${article.title} | Go Green Restoration`;
const description = article.description;
const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Resources', url: '/resources/' },
  { name: cluster.name, url: `/resources/${cluster.slug}/` },
  { name: article.title, url: `/resources/${cluster.slug}/${article.slug}/` },
];

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": article.title,
  "description": article.description,
  ...(article.image ? { "image": `https://gogreenrestorationtx.com${article.image}` } : {}),
  "publisher": {
    "@type": "Organization",
    "name": "Go Green Restoration TX Inc",
    "url": "https://gogreenrestorationtx.com",
    "logo": "https://gogreenrestorationtx.com/logo.png"
  },
  "mainEntityOfPage": `https://gogreenrestorationtx.com/resources/${article.cluster}/${article.slug}/`
};

// Convert markdown-like content to HTML paragraphs, headings, links, images, and lists
function renderContent(content: string): string {
  return content.split('\n\n').map(block => {
    if (block.startsWith('## ')) {
      return `<h2 class="font-heading text-2xl font-bold text-brand-gray-900 mt-8 mb-4">${block.replace('## ', '')}</h2>`;
    }
    // Handle markdown image: ![alt](url)
    if (block.match(/^!\[/)) {
      const imgMatch = block.match(/^!\[([^\]]*)\]\(([^)]+)\)/);
      if (imgMatch) {
        return `<img src="${imgMatch[2]}" alt="${imgMatch[1]}" class="rounded-xl w-full my-6" loading="lazy" />`;
      }
    }
    // Handle unordered list items (- item)
    if (block.match(/^- /m)) {
      const items = block.split('\n').filter(l => l.startsWith('- ')).map(l => {
        let text = l.replace(/^- /, '');
        text = text.replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2" class="text-brand-brown hover:underline">$1</a>');
        return `<li>${text}</li>`;
      }).join('');
      return `<ul class="list-disc pl-6 space-y-1 text-brand-gray-600 mb-4">${items}</ul>`;
    }
    // Convert markdown links [text](url) to HTML <a> tags
    let html = block.replace(
      /\[([^\]]+)\]\(([^)]+)\)/g,
      '<a href="$2" class="text-brand-brown hover:underline">$1</a>'
    );
    // Convert **bold** to <strong>
    html = html.replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');
    return `<p class="text-brand-gray-600 leading-relaxed mb-4">${html}</p>`;
  }).join('');
}
---

<BaseLayout title={title} description={description} ogImage={article.image} schema={[articleSchema]}>
  <Breadcrumbs items={breadcrumbs} />

  <article class="max-w-7xl mx-auto px-4 py-12">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
      <!-- Main Content -->
      <div class="lg:col-span-2">
        <div class="mb-4">
          <a href={`/resources/${cluster.slug}/`} class="text-brand-orange text-sm font-medium hover:underline">&larr; {cluster.name} Resources</a>
        </div>
        <h1 class="font-heading text-3xl lg:text-4xl font-black text-brand-gray-900 mb-4">{article.title}</h1>
        {article.image && (
          <img src={article.image} alt={article.imageAlt || article.title} class="w-full rounded-xl mb-6" loading="eager" width={article.imageGenerated ? 1280 : 1200} height={article.imageGenerated ? 716 : 630} />
        )}
        {article.imageGenerated && <p class="text-sm text-brand-gray-600 mb-6">AI-generated service illustration; not a photograph of a completed local project.</p>}
        <p class="text-lg text-brand-gray-600 mb-8 border-b border-brand-gray-200 pb-8">{article.description}</p>

        {articleCity && cluster.serviceSlug && <aside class="bg-brand-warm rounded-xl p-5 mb-8">
          <p>{cluster.slug === 'mold' ? 'Have a mold concern? Contact Go Green Restoration TX Inc about your property, the affected rooms and the next step.' : `Need help at a ${articleCity.name} property? Review the service scope and contact our team to discuss access and availability.`}</p>
          <a href={`/${cluster.serviceSlug}/${articleCity.slug}/`} class="inline-block mt-3 text-brand-brown underline">{cluster.slug === 'mold' ? 'Mold removal and remediation help' : cluster.serviceName} in {articleCity.name}</a>
        </aside>}
        {cluster.slug === 'hoa-property-management' && <p class="mb-8"><a href="/commercial/hoa-restoration-services/" class="text-brand-brown underline">HOA property restoration planning</a> · <a href="/commercial/property-management-restoration/" class="text-brand-brown underline">Restoration for property managers</a></p>}
        <div class="prose max-w-none" set:html={renderContent(article.content)} />
        {compactTopics.length > 0 && <aside class="bg-brand-warm rounded-xl p-5 my-8"><h2 class="font-heading text-xl font-bold mb-3">Planning cleanup at your property?</h2><p class="mb-3">These service pages explain first-visit details, scope decisions, and information to share when requesting an estimate.</p><ul class="list-disc pl-5">{compactTopics.map(topic => <li><a class="text-brand-brown underline" href={compactServiceUrl(topic.slug,articleCity?.slug)}>{topic.name}</a></li>)}</ul></aside>}

        {['hidden-water-damage-warning-signs-plano','structural-drying-and-mold-prevention-frisco','spotting-small-mold-problems-early-plano','rebuild-timeline-and-cost-frisco'].includes(article.slug) && <RealEstateLinks kind={article.cluster === 'mold' ? 'mold' : article.cluster === 'water-damage' ? 'water' : 'repair'} />}
        {articleCity && <p class="mt-8 text-brand-gray-600">For help with other damage at the same property, explore <a class="text-brand-brown underline" href={`/locations/dfw-metro/${articleCity.slug}/`}>restoration services in {articleCity.name}</a>.</p>}

        <!-- CTA -->
        <div class="mt-12 bg-brand-warm-100 rounded-xl p-8">
          <h2 class="font-heading text-xl font-bold text-brand-gray-900 mb-3">Need Professional Help?</h2>
          <p class="text-brand-gray-600 mb-4">Go Green Restoration TX Inc serves Dallas–Fort Worth. Contact us to discuss your property and the appropriate service scope.</p>
          <div class="flex flex-col sm:flex-row gap-4">
            <a href="tel:+14697273217" class="bg-brand-green hover:bg-brand-green-light text-white font-bold px-6 py-3 rounded-lg text-center transition-colors">Call (469) 727-3217</a>
            {cluster.serviceSlug && (
              <a href={`/services/${cluster.serviceSlug}/`} class="bg-brand-green hover:bg-brand-green-light text-white font-bold px-6 py-3 rounded-lg text-center transition-colors">View {cluster.serviceName} Services</a>
            )}
          </div>
        </div>
      </div>

      <!-- Sidebar -->
      <div class="lg:col-span-1">
        <div class="sticky top-24 space-y-6">
          <!-- Related Articles -->
          {relatedArticles.length > 0 && (
            <div class="bg-brand-gray-50 rounded-xl p-6">
              <h3 class="font-heading font-bold text-lg mb-4">Related Articles</h3>
              <div class="space-y-3">
                {relatedArticles.map((related) => (
                  <a href={`/resources/${related.cluster}/${related.slug}/`} class="block text-sm text-brand-gray-800 hover:text-brand-brown transition-colors py-1">
                    {related.title}
                  </a>
                ))}
              </div>
            </div>
          )}

          <!-- Service Link -->
          {cluster.serviceSlug && (
            <div class="bg-brand-brown text-white rounded-xl p-6">
              <h3 class="font-heading font-bold text-lg mb-2">{cluster.serviceName}</h3>
              <p class="text-brand-warm-200 text-sm mb-4">Serving Dallas, Collin County, and wider DFW from Wylie.</p>
              <a href={`/services/${cluster.serviceSlug}/`} class="block bg-brand-green hover:bg-brand-green-light text-white font-bold text-center py-3 rounded-lg transition-colors">Learn More</a>
            </div>
          )}

          <!-- Emergency Contact -->
          <div class="bg-brand-gray-50 rounded-xl p-6">
            <h3 class="font-heading font-bold text-lg mb-2">24/7 Emergency</h3>
            <a href="tel:+14697273217" class="text-2xl font-bold text-brand-orange hover:text-brand-orange-light transition-colors">(469) 727-3217</a>
            <p class="text-sm text-brand-gray-600 mt-2">Wylie-based team | Free Estimates</p>
          </div>
        </div>
      </div>
    </div>
  </article>
</BaseLayout>
