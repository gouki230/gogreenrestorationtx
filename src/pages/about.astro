---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
const title = 'About Go Green Restoration TX Inc | Our DFW Team';
const description = 'Meet Rey Aquije and Yani Abohazira, each with over 15 years of mold remediation and water restoration experience. Serving Dallas–Fort Worth from Wylie.';
const breadcrumbs = [{ name: 'Home', url: '/' }, { name: 'About', url: '/about/' }];
---
<BaseLayout title={title} description={description}>
  <Breadcrumbs items={breadcrumbs} />
  <section class="bg-brand-brown text-white"><div class="max-w-5xl mx-auto px-4 py-16">
    <h1 class="font-heading text-4xl lg:text-5xl font-black mb-5">About Go Green Restoration TX Inc</h1>
    <p class="text-lg max-w-3xl">Mold cleanup and property restoration support for Dallas, Collin County and the wider Dallas–Fort Worth area, from our Wylie location.</p>
  </div></section>
  <div class="max-w-5xl mx-auto px-4 py-12 space-y-12">
    <section><h2 class="text-3xl font-bold mb-6">Meet our team</h2>
      <div class="grid md:grid-cols-2 gap-6">
        {['Rey Aquije', 'Yani Abohazira'].map(name => <div class="bg-brand-gray-50 rounded-xl p-6"><h3 class="text-xl font-bold mb-3">{name}</h3><p>{name} brings more than 15 years of experience in mold remediation and water damage restoration. That experience informs how our team discusses affected materials, containment, cleanup and the next steps for a property.</p></div>)}
      </div>
    </section>
    <section><h2 class="text-2xl font-bold mb-4">How we help</h2><p class="mb-4">Start by telling us what happened, which rooms are affected and whether the water source has been repaired. We discuss the work required, access to the property and who needs to approve the next step. For insurance claims, we can help with project documentation; coverage decisions remain with your insurer.</p><p>We welcome mold projects of any size and work with appropriately licensed partner companies when the project requires it. Contact us to discuss the affected spaces, access and next steps.</p><a href="/services/mold-remediation/" class="inline-block mt-4 underline font-bold text-brand-brown">Explore our mold removal and remediation process</a></section>
    <section><h2 class="text-2xl font-bold mb-4">See our Texas project work</h2><p class="mb-4">These accounts explain the leak sources, work performed and outcomes reported by our team, alongside photographs shared with permission.</p><ul class="list-disc pl-6 space-y-3"><li><a class="underline" href="/projects/dallas-kitchen-laundry-mold-remediation/">Dallas kitchen and laundry mold project — September 2026</a></li><li><a class="underline" href="/projects/arlington-bathroom-mold-remediation/">Arlington bathroom mold project — August 2026</a></li></ul></section>
    <section><h2 class="text-2xl font-bold mb-4">Based in Wylie, serving DFW</h2><p class="mb-3">611 S State Hwy 78, Suite 133B, Wylie, TX 75098</p><p class="mb-4">Our service areas include Dallas, Plano, Frisco and McKinney. We travel to properties across DFW from Wylie. Emergency calls are accepted 24/7; call to confirm arrival availability for your address.</p><p><a class="underline" href="tel:+14697273217">(469) 727-3217</a> · <a class="underline break-words" href="mailto:info@gogreenrestorationtx.com">info@gogreenrestorationtx.com</a></p><a href="/contact/" class="inline-block mt-6 bg-brand-green text-white rounded-lg px-6 py-3 font-bold">Discuss your property</a></section>
  </div>
</BaseLayout>
