---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import services from '../../../data/services.json';
import dfwCities, { isCorePathAvailable } from '../../../utils/service-area-cities';
const directoryCities = dfwCities.filter(city => isCorePathAvailable(`/locations/dfw-metro/${city.slug}/`));

const title = 'Restoration Services in DFW Metro Area | Go Green Restoration';
const description = 'Go Green Restoration serves all cities in DFW Metro Area. Water damage, fire damage, mold remediation, sewage cleanup & construction. 24/7 emergency.';
const breadcrumbs = [{ name: 'Home', url: '/' }, { name: 'Locations', url: '/locations/' }, { name: 'DFW Metro Area', url: '/locations/dfw-metro/' }];

const incorporated = directoryCities.filter(c => c.type === 'incorporated').sort((a, b) => a.name.localeCompare(b.name));
const unincorporated = directoryCities.filter(c => c.type === 'unincorporated').sort((a, b) => a.name.localeCompare(b.name));
---

<BaseLayout title={title} description={description}>
  <Breadcrumbs items={breadcrumbs} />
  <section class="max-w-7xl mx-auto px-4 py-12">
    <h1 class="font-heading text-4xl lg:text-5xl font-extrabold text-brand-gray-900 mb-6">Restoration Services in DFW Metro Area</h1>
    <p class="text-lg text-brand-gray-600 max-w-3xl mb-12">Go Green Restoration TX Inc serves homes and businesses across Dallas–Fort Worth. Choose your city for water damage, mold, fire damage, sewage cleanup, and reconstruction services. Call to confirm availability and an arrival estimate for your address.</p>

    <div class="mb-12">
      <h2 class="font-heading text-2xl font-bold text-brand-gray-900 mb-4">Our Services</h2>
      <div class="flex flex-wrap gap-3">
        {services.map((s) => (
          <a href={`/services/${s.slug}/`} class="bg-brand-warm-100 text-brand-green px-4 py-2 rounded-full text-sm font-medium hover:bg-brand-green-100 transition-colors">{s.name}</a>
        ))}
      </div>
    </div>

    <div class="mb-12">
      <h2 class="font-heading text-2xl font-bold text-brand-gray-900 mb-6">Cities and towns ({incorporated.length})</h2>
      <label for="location-search" class="block font-bold mb-2">Find your city</label>
      <input id="location-search" type="search" placeholder="Search cities and towns" class="border rounded-lg p-3 w-full max-w-xl mb-5" />
      <div id="city-directory" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-3">
        {incorporated.map((city) => (
          <a href={`/locations/dfw-metro/${city.slug}/`} class="text-sm text-brand-gray-800 hover:text-brand-brown transition-colors py-1">{city.name}</a>
        ))}
      </div>
    </div>

    {unincorporated.length > 0 && <div class="mb-12">
      <h2 class="font-heading text-2xl font-bold text-brand-gray-900 mb-6">Communities</h2>
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-3">
        {unincorporated.map((city) => (
          <a href={`/locations/dfw-metro/${city.slug}/`} class="text-sm text-brand-gray-800 hover:text-brand-brown transition-colors py-1">{city.name}</a>
        ))}
      </div>
    </div>}

    <div class="text-center">
      <a href="/locations/dfw-metro/" class="text-brand-brown font-medium hover:underline">View DFW Metro Area locations &rarr;</a>
    </div>
  </section>
</BaseLayout>

<script>
const input=document.querySelector<HTMLInputElement>('#location-search');
input?.addEventListener('input',()=>{const query=input.value.trim().toLowerCase();document.querySelectorAll<HTMLAnchorElement>('#city-directory a').forEach(link=>{link.hidden=!link.textContent?.toLowerCase().includes(query)});});
</script>
