---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import CityMap from '../../../components/CityMap.astro';
import services from '../../../data/services.json';
import dfwCities from '../../../data/cities-dfw-metro.json';
import { getNearbyCities } from '../../../utils/content';

export function getStaticPaths() {
  return dfwCities.map((city) => ({
    params: { city: city.slug },
    props: { city },
  }));
}

const { city } = Astro.props;
const allCities = dfwCities;
const nearbyCities = getNearbyCities(city.nearbyCities || [], allCities, 6);

const title = `Restoration Services in ${city.name}, TX | Go Green Restoration`;
const description = `24/7 restoration services in ${city.name}, DFW Metro Area. Water damage, fire damage, mold cleanup, sewage cleanup & construction. Bonded & insured, EPA Lead-Safe certified.`;
const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Locations', url: '/locations/' },
  { name: 'DFW Metro Area', url: '/locations/dfw-metro/' },
  { name: city.name, url: `/locations/dfw-metro/${city.slug}/` },
];

const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": `Go Green Restoration - ${city.name}`,
  "url": `https://gogreenrestorationtx.com/locations/dfw-metro/${city.slug}/`,
  "telephone": "+1-469-727-3217",
  "address": { "@type": "PostalAddress", "addressLocality": city.name, "addressRegion": "TX", "postalCode": city.zips?.[0] || '', "addressCountry": "US" },
  "areaServed": { "@type": "City", "name": city.name },
  "openingHoursSpecification": { "@type": "OpeningHoursSpecification", "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday","Sunday"], "opens": "00:00", "closes": "23:59" },
  "aggregateRating": { "@type": "AggregateRating", "ratingValue": "5.0", "reviewCount": "45", "bestRating": "5", "worstRating": "1" }
};

const serviceIcons: Record<string, string> = {
  droplet: '💧', flame: '🔥', shield: '🛡️', 'alert-triangle': '⚠️', hammer: '🔨',
};
---

<BaseLayout title={title} description={description} schema={[localBusinessSchema]}>
  <Breadcrumbs items={breadcrumbs} />

  <section class="bg-gradient-to-br from-brand-brown to-brand-brown-dark text-white">
    <div class="max-w-7xl mx-auto px-4 py-12 lg:py-16">
      <h1 class="font-heading text-3xl lg:text-4xl xl:text-5xl font-black mb-4">Restoration Services in {city.name}, Texas</h1>
      <p class="text-lg text-brand-warm-200 mb-6">Water, Fire, Mold & More | 24/7 Emergency | EPA Lead-Safe Certified</p>
      <a href="tel:+14697273217" class="inline-block bg-brand-green hover:bg-brand-green-light text-white font-bold px-8 py-4 rounded-lg transition-colors">Call Now: (469) 727-3217</a>
    </div>
  </section>

  <div class="max-w-7xl mx-auto px-4 py-12">
    <!-- City Overview -->
    <div class="mb-12 max-w-3xl">
      <h2 class="font-heading text-2xl font-bold text-brand-gray-900 mb-4">Go Green Restoration in {city.name}</h2>
      <p class="text-brand-gray-600 leading-relaxed">Go Green Restoration Inc provides comprehensive property restoration services to {city.name} and the surrounding DFW Metro Area area. With 24/7 emergency response, eco-friendly methods, and a commitment to quality, we're the trusted choice for residential and commercial restoration in {city.name}.</p>
      {city.commonIssues && <p class="text-brand-gray-600 leading-relaxed mt-4">{city.commonIssues}</p>}
    </div>

    <!-- Services Grid -->
    <div class="mb-12">
      <h2 class="font-heading text-2xl font-bold text-brand-gray-900 mb-6">Our Services in {city.name}</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {services.map((s) => (
          <a href={`/${s.slug}/${city.slug}/`} class="group flex items-center gap-3 bg-brand-gray-50 hover:bg-brand-warm-100 rounded-xl p-5 transition-all border border-transparent hover:border-brand-green-200">
            <span class="text-2xl">{serviceIcons[s.icon]}</span>
            <div>
              <h3 class="font-heading font-bold text-brand-gray-900 group-hover:text-brand-brown">{s.name}</h3>
              <span class="text-brand-orange text-sm">in {city.name} &rarr;</span>
            </div>
          </a>
        ))}
      </div>
    </div>

    <!-- Commercial Services -->
    <div class="mb-12">
      <h2 class="font-heading text-2xl font-bold text-brand-gray-900 mb-4">Commercial Services in {city.name}</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <a href={`/commercial/hoa-restoration-services/${city.slug}/`} class="group bg-brand-gray-50 hover:bg-brand-warm-100 rounded-xl p-5 transition-all border border-transparent hover:border-brand-green-200">
          <h3 class="font-heading font-bold text-brand-gray-900 group-hover:text-brand-brown">HOA Restoration Services</h3>
          <span class="text-brand-orange text-sm">in {city.name} &rarr;</span>
        </a>
        <a href={`/commercial/property-management-restoration/${city.slug}/`} class="group bg-brand-gray-50 hover:bg-brand-warm-100 rounded-xl p-5 transition-all border border-transparent hover:border-brand-green-200">
          <h3 class="font-heading font-bold text-brand-gray-900 group-hover:text-brand-brown">Property Management Restoration</h3>
          <span class="text-brand-orange text-sm">in {city.name} &rarr;</span>
        </a>
      </div>
    </div>

    <!-- Neighborhoods & Zips -->
    {(city.neighborhoods?.length > 0 || city.zips?.length > 0) && (
      <div class="mb-12">
        <h2 class="font-heading text-2xl font-bold text-brand-gray-900 mb-4">{city.name} Areas We Serve</h2>
        {city.neighborhoods?.length > 0 && (
          <div class="mb-4">
            <h3 class="font-bold mb-2">Neighborhoods</h3>
            <div class="flex flex-wrap gap-2">{city.neighborhoods.map((n: string) => <span class="bg-brand-gray-50 px-3 py-1.5 rounded-full text-sm">{n}</span>)}</div>
          </div>
        )}
        {city.zips?.length > 0 && (
          <div>
            <h3 class="font-bold mb-2">ZIP Codes</h3>
            <div class="flex flex-wrap gap-2">{city.zips.map((z: string) => <span class="bg-brand-gray-50 px-3 py-1.5 rounded-full text-sm">{z}</span>)}</div>
          </div>
        )}
      </div>
    )}

    <!-- Map -->
    {city.lat && city.lng && (
      <div class="mb-12">
        <h2 class="font-heading text-2xl font-bold text-brand-gray-900 mb-4">Our Service Area in {city.name}</h2>
        <CityMap lat={city.lat} lng={city.lng} cityName={city.name} />
      </div>
    )}

    <!-- Nearby Cities -->
    {nearbyCities.length > 0 && (
      <div class="mb-12">
        <h2 class="font-heading text-2xl font-bold text-brand-gray-900 mb-4">Nearby Service Areas</h2>
        <div class="flex flex-wrap gap-3">
          {nearbyCities.map((nearby) => (
            <a href={`/locations/dfw-metro/${nearby.slug}/`} class="bg-brand-gray-50 hover:bg-brand-warm-100 px-4 py-2 rounded-full text-sm hover:text-brand-brown transition-colors border border-brand-gray-200">{nearby.name}</a>
          ))}
        </div>
      </div>
    )}

    <!-- CTA -->
    <div class="bg-brand-brown text-white rounded-2xl p-8 lg:p-12 text-center">
      <h2 class="font-heading text-2xl lg:text-3xl font-bold mb-4">Need Restoration Help in {city.name}?</h2>
      <p class="text-brand-warm-200 mb-6">Contact us 24/7 for emergency restoration services in {city.name}. Free estimates and insurance claims assistance.</p>
      <div class="flex flex-col sm:flex-row justify-center gap-4">
        <a href="tel:+14697273217" class="bg-brand-green hover:bg-brand-green-light font-bold px-8 py-4 rounded-lg transition-colors">Call (469) 727-3217</a>
        <a href="/contact/" class="bg-white/10 hover:bg-white/20 font-bold px-8 py-4 rounded-lg transition-colors border border-white/30">Get Free Estimate</a>
      </div>
    </div>
  </div>
</BaseLayout>
