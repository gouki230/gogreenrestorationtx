---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

const title = '24/7 Emergency Restoration Services | Go Green Restoration Inc';
const description = 'Emergency water, fire, mold, and sewage restoration in Dallas-Fort Worth metroplex. 60-minute response time. Call (469) 727-3217 now. Bonded & insured.';
const breadcrumbs = [{ name: 'Home', url: '/' }, { name: 'Emergency', url: '/emergency/' }];
---

<BaseLayout title={title} description={description}>
  <Breadcrumbs items={breadcrumbs} />

  <section class="bg-brand-orange text-white">
    <div class="max-w-4xl mx-auto px-4 py-16 text-center">
      <h1 class="font-heading text-4xl lg:text-5xl font-black mb-4">24/7 Emergency Restoration</h1>
      <p class="text-xl text-white/90 mb-8">Every minute counts. Our emergency team responds within 60 minutes throughout Dallas-Fort Worth metroplex.</p>
      <a href="tel:+14697273217" class="inline-block bg-white text-brand-orange hover:bg-brand-gray-50 font-bold text-2xl px-12 py-6 rounded-lg transition-colors shadow-lg">
        Call Now: (469) 727-3217
      </a>
      <p class="mt-4 text-white/80">Bonded & Insured | Free Estimates</p>
    </div>
  </section>

  <div class="max-w-7xl mx-auto px-4 py-12">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-16">
      <a href="/services/water-damage-restoration/" class="group bg-brand-gray-50 hover:bg-brand-warm-100 rounded-xl p-6 text-center transition-all hover:shadow-lg border border-transparent hover:border-brand-green-200">
        <div class="text-4xl mb-3">💧</div>
        <h2 class="font-heading font-bold text-lg text-brand-gray-900 group-hover:text-brand-brown">Water Damage</h2>
        <p class="text-sm text-brand-gray-600 mt-1">Burst pipes, flooding, leaks</p>
      </a>
      <a href="/services/fire-smoke-damage-restoration/" class="group bg-brand-gray-50 hover:bg-brand-warm-100 rounded-xl p-6 text-center transition-all hover:shadow-lg border border-transparent hover:border-brand-green-200">
        <div class="text-4xl mb-3">🔥</div>
        <h2 class="font-heading font-bold text-lg text-brand-gray-900 group-hover:text-brand-brown">Fire & Smoke</h2>
        <p class="text-sm text-brand-gray-600 mt-1">Fire damage, smoke, soot</p>
      </a>
      <a href="/services/mold-remediation/" class="group bg-brand-gray-50 hover:bg-brand-warm-100 rounded-xl p-6 text-center transition-all hover:shadow-lg border border-transparent hover:border-brand-green-200">
        <div class="text-4xl mb-3">🛡️</div>
        <h2 class="font-heading font-bold text-lg text-brand-gray-900 group-hover:text-brand-brown">Mold</h2>
        <p class="text-sm text-brand-gray-600 mt-1">Mold growth, contamination</p>
      </a>
      <a href="/services/sewage-backup-cleanup/" class="group bg-brand-gray-50 hover:bg-brand-warm-100 rounded-xl p-6 text-center transition-all hover:shadow-lg border border-transparent hover:border-brand-green-200">
        <div class="text-4xl mb-3">⚠️</div>
        <h2 class="font-heading font-bold text-lg text-brand-gray-900 group-hover:text-brand-brown">Sewage</h2>
        <p class="text-sm text-brand-gray-600 mt-1">Sewage backup, biohazard</p>
      </a>
    </div>

    <div class="max-w-3xl mx-auto mb-16">
      <h2 class="font-heading text-2xl font-bold text-brand-gray-900 mb-6">What to Do Right Now</h2>
      <div class="space-y-4">
        <div class="flex gap-4 bg-brand-gray-50 rounded-xl p-6">
          <div class="w-10 h-10 bg-brand-orange rounded-full flex items-center justify-center text-white font-bold shrink-0">1</div>
          <div><h3 class="font-bold text-lg">Call Us Immediately</h3><p class="text-brand-gray-600 text-sm">Call (469) 727-3217. Our dispatch team will gather details and send a crew to your location.</p></div>
        </div>
        <div class="flex gap-4 bg-brand-gray-50 rounded-xl p-6">
          <div class="w-10 h-10 bg-brand-orange rounded-full flex items-center justify-center text-white font-bold shrink-0">2</div>
          <div><h3 class="font-bold text-lg">Ensure Safety</h3><p class="text-brand-gray-600 text-sm">Evacuate if necessary. Turn off the water source for flooding. Stay away from electrical hazards. Don't enter fire-damaged structures.</p></div>
        </div>
        <div class="flex gap-4 bg-brand-gray-50 rounded-xl p-6">
          <div class="w-10 h-10 bg-brand-orange rounded-full flex items-center justify-center text-white font-bold shrink-0">3</div>
          <div><h3 class="font-bold text-lg">Document If Safe</h3><p class="text-brand-gray-600 text-sm">If it's safe to do so, take photos and video of the damage for insurance purposes. Don't throw anything away.</p></div>
        </div>
        <div class="flex gap-4 bg-brand-gray-50 rounded-xl p-6">
          <div class="w-10 h-10 bg-brand-orange rounded-full flex items-center justify-center text-white font-bold shrink-0">4</div>
          <div><h3 class="font-bold text-lg">We Arrive & Take Over</h3><p class="text-brand-gray-600 text-sm">Our certified team arrives within 60 minutes with all necessary equipment. We handle everything from here — including your insurance claim.</p></div>
        </div>
      </div>
    </div>

    <div class="bg-brand-brown text-white rounded-2xl p-8 lg:p-12 text-center">
      <h2 class="font-heading text-2xl lg:text-3xl font-bold mb-4">Don't Wait — Every Minute Counts</h2>
      <p class="text-brand-warm-200 mb-6 max-w-2xl mx-auto">Water damage worsens by the minute. Mold starts growing within 24 hours. Smoke and soot cause permanent damage if not addressed quickly.</p>
      <a href="tel:+14697273217" class="inline-block bg-brand-orange hover:bg-brand-orange-light font-bold text-xl px-12 py-5 rounded-lg transition-colors">Call (469) 727-3217 Now</a>
    </div>
  </div>
</BaseLayout>
