      <div class="text-center mb-12">
        <h2 class="font-heading text-3xl lg:text-4xl font-bold text-brand-gray-900 mb-4 reveal">Our Happy Customers</h2>
        <p class="text-lg text-brand-gray-600 max-w-2xl mx-auto">See what our clients say about their experience with Go Green Restoration.</p>
      </div>

      <!-- Video Testimonials -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-4xl mx-auto mb-12 reveal">
        <div class="rounded-xl overflow-hidden shadow-lg aspect-video">
          <iframe
            src="https://www.youtube.com/embed/16zVA1TXfEg?rel=0"
            title="Go Green Restoration Customer Experience"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
            loading="lazy"
            class="w-full h-full"
          ></iframe>
        </div>
        <div class="rounded-xl overflow-hidden shadow-lg aspect-video">
          <iframe
            src="https://www.youtube.com/embed/lsyrkOaf0JI?rel=0"
            title="Go Green Restoration Service Review"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
            loading="lazy"
            class="w-full h-full"
          ></iframe>
        </div>
      </div>

      <!-- Google Reviews (fetched at build time via Places API) -->
      <div class="flex items-center justify-center gap-3 mb-8">
        <img src="https://www.google.com/favicon.ico" alt="Google" width="24" height="24" class="w-6 h-6" />
        <span class="font-heading font-bold text-lg text-brand-gray-900">{googleReviews.rating} stars</span>
        <span class="text-yellow-500 text-xl">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
        <span class="text-brand-gray-600">based on {googleReviews.totalReviews} Google reviews</span>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 stagger-children">
        {googleReviews.reviews.slice(0, 6).map((review) => (
          <div class="bg-brand-warm rounded-xl p-6 border border-brand-warm-200">
            <div class="flex items-center gap-2 mb-3">
              <img src="https://www.google.com/favicon.ico" alt="Google Review" width="16" height="16" class="w-4 h-4" />
              <div class="flex">
                {Array.from({ length: review.rating }).map(() => (
                  <span class="text-yellow-500 text-sm">&#9733;</span>
                ))}
              </div>
              <span class="text-xs text-brand-gray-600 ml-auto">{review.relativeTime}</span>
            </div>
            <p class="text-brand-gray-600 text-sm mb-4 line-clamp-4">{review.text}</p>
            <div class="flex items-center gap-2">
              {review.authorPhoto && (
                <img src={review.authorPhoto} alt={review.author} width="32" height="32" class="w-8 h-8 rounded-full" loading="lazy" referrerpolicy="no-referrer" />
              )}
              <span class="font-medium text-sm text-brand-gray-900">{review.author}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Emergency CTA Section -->
  <section class="py-16 lg:py-20 bg-brand-brown text-white dot-pattern">
    <div class="max-w-4xl mx-auto px-4 text-center relative z-10">
      <h2 class="font-heading text-3xl lg:text-4xl font-bold mb-4 reveal heading-3d">Water, Fire, or Mold Emergency?</h2>
      <p class="text-lg text-white/90 mb-8 reveal">Don't wait. Our 24/7 emergency team is ready to respond immediately. Every minute counts when it comes to property damage.</p>
      <div class="flex flex-col sm:flex-row justify-center gap-4 reveal">
        <a href="tel:+14697273217" class="bg-white text-brand-brown hover:bg-brand-warm font-bold text-lg px-8 py-4 rounded-lg transition-colors">Call (469) 727-3217</a>
        <a href="/contact/" class="bg-white/10 hover:bg-white/20 text-white font-bold text-lg px-8 py-4 rounded-lg transition-colors border border-white/30">Request Callback</a>
      </div>
    </div>
  </section>

</BaseLayout>
