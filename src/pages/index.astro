---
import BaseLayout from '../layouts/BaseLayout.astro';
import CountyMap from '../components/CountyMap.astro';
import services from '../data/services.json';
import googleReviews from '../data/google-reviews.json';

const title = 'Go Green Restoration TX | 24/7 Water, Fire & Mold Damage Restoration in DFW Metro';
const description = 'Bonded and insured eco-friendly restoration company serving the Dallas-Fort Worth Metroplex. 24/7 emergency water damage, fire damage, mold remediation, sewage cleanup & construction. Free estimates.';

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Go Green Restoration Inc",
  "url": "https://gogreenrestorationtx.com",
  "potentialAction": {
    "@type": "SearchAction",
    "target": "https://gogreenrestorationtx.com/search?q={search_term_string}",
    "query-input": "required name=search_term_string"
  }
};

const reviewSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "Go Green Restoration Inc",
  "url": "https://gogreenrestorationtx.com",
  "telephone": "+1-469-727-3217",
  "address": [
    { "@type": "PostalAddress", "streetAddress": "1902 Parker Rd", "addressLocality": "Wylie", "addressRegion": "TX", "postalCode": "75098", "addressCountry": "US" }
  ],
  "aggregateRating": { "@type": "AggregateRating", "ratingValue": "5.0", "reviewCount": "1", "bestRating": "5", "worstRating": "1" },
  "review": [
    { "@type": "Review", "author": { "@type": "Person", "name": "Logan L." }, "reviewRating": { "@type": "Rating", "ratingValue": "5", "bestRating": "5" }, "reviewBody": "Go Green Restoration was incredible. They responded within the hour after our pipe burst and had everything dried out and repaired faster than we expected. Professional, courteous, and they worked directly with our insurance." },
    { "@type": "Review", "author": { "@type": "Person", "name": "Sabrina K." }, "reviewRating": { "@type": "Rating", "ratingValue": "5", "bestRating": "5" }, "reviewBody": "After finding mold in our bathroom, we called Go Green and they were out the next day. They explained everything clearly, contained the area properly, and removed all the mold. Our air quality test came back clean." },
    { "@type": "Review", "author": { "@type": "Person", "name": "Reynaldo A." }, "reviewRating": { "@type": "Rating", "ratingValue": "5", "bestRating": "5" }, "reviewBody": "We had fire damage in our kitchen and Go Green handled everything - from boarding up the same night to the complete rebuild. They made the insurance process painless and our kitchen looks even better than before." }
  ]
};

// SVG paths for each service icon (used in the floating badge on each card)
const serviceIconSvg: Record<string, string> = {
  droplet: '<path d="M12 2.5c0 0-6.5 7-6.5 12.5a6.5 6.5 0 1013 0c0-5.5-6.5-12.5-6.5-12.5z" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" fill="none"/>',
  flame: '<path d="M12 2.5s-1 3 1 5.5c1.5 1.875 4 3.5 4 7a5 5 0 11-10 0c0-3.5 2-5 2-8C9 3.5 12 2.5 12 2.5z" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" fill="none"/>',
  mold: '<circle cx="12" cy="12" r="3" stroke-width="1.8" fill="none"/><circle cx="6" cy="8" r="1.5" fill="currentColor"/><circle cx="18" cy="9" r="1.5" fill="currentColor"/><circle cx="7" cy="17" r="1.5" fill="currentColor"/><circle cx="17" cy="16" r="1.5" fill="currentColor"/><circle cx="12" cy="5" r="1" fill="currentColor"/><circle cx="12" cy="19" r="1" fill="currentColor"/>',
  pipe: '<path d="M4 9h6V5h4v4h6v6h-6v4h-4v-4H4z" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" fill="none"/>',
  house: '<path d="M3 11l9-7 9 7v9a1 1 0 01-1 1h-5v-7h-6v7H4a1 1 0 01-1-1v-9z" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" fill="none"/>',
};
// Legacy emoji fallback (kept for any cross-link references that still use it)
const serviceIcons: Record<string, string> = {
  droplet: '💧', flame: '🔥', shield: '🛡️', mold: '🦠', 'alert-triangle': '⚠️', pipe: '🚽', hammer: '🔨', house: '🏠',
};

const featuredCities = [
  { name: 'Dallas', slug: 'dallas', county: 'dfw-metro' },
  { name: 'Fort Worth', slug: 'fort-worth', county: 'dfw-metro' },
  { name: 'Plano', slug: 'plano', county: 'dfw-metro' },
  { name: 'Arlington', slug: 'arlington', county: 'dfw-metro' },
  { name: 'Frisco', slug: 'frisco', county: 'dfw-metro' },
  { name: 'McKinney', slug: 'mckinney', county: 'dfw-metro' },
  { name: 'Irving', slug: 'irving', county: 'dfw-metro' },
  { name: 'Garland', slug: 'garland', county: 'dfw-metro' },
  { name: 'Grapevine', slug: 'grapevine', county: 'dfw-metro' },
  { name: 'Southlake', slug: 'southlake', county: 'dfw-metro' },
];
---

<BaseLayout title={title} description={description} schema={[websiteSchema, reviewSchema]}>

  <!-- Hero Section with Background Video -->
  <section class="relative overflow-hidden text-white min-h-[600px] lg:min-h-[680px] flex flex-col" id="hero-section">
    <!-- Poster Image (loads instantly) -->
    <div class="absolute inset-0 z-0">
      <img
        src="/hero-poster.jpg"
        alt=""
        class="w-full h-full object-cover"
        fetchpriority="high"
        decoding="async"
      />
    </div>
    <!-- YouTube Background Video (lazy-loaded, fades in over poster) -->
    <div id="hero-video-container" class="absolute inset-0 z-[1] overflow-hidden opacity-0 transition-opacity duration-1000">
      <div id="hero-video-wrap" class="absolute" style="top:50%;left:50%;transform:translate(-50%,-50%);">
        <!-- iframe injected by JS after page load -->
      </div>
    </div>
    <!-- Dark Overlay with subtle gradient from left -->
    <div class="absolute inset-0 bg-gradient-to-r from-black/85 via-black/65 to-black/30 z-10"></div>
    <script>
      function scaleVideo() {
        const section = document.getElementById('hero-section');
        const wrap = document.getElementById('hero-video-wrap');
        if (!section || !wrap) return;
        const sw = section.offsetWidth;
        const sh = section.offsetHeight;
        const videoRatio = 16 / 9;
        let w, h;
        if (sw / sh > videoRatio) {
          w = sw;
          h = sw / videoRatio;
        } else {
          h = sh;
          w = sh * videoRatio;
        }
        w *= 1.2;
        h *= 1.2;
        wrap.style.width = w + 'px';
        wrap.style.height = h + 'px';
      }

      function loadVideo() {
        const wrap = document.getElementById('hero-video-wrap');
        const container = document.getElementById('hero-video-container');
        if (!wrap || !container) return;
        const iframe = document.createElement('iframe');
        iframe.src = 'https://www.youtube.com/embed/G-KfCmJHxTI?autoplay=1&mute=1&loop=1&playlist=G-KfCmJHxTI&controls=0&showinfo=0&rel=0&modestbranding=1&playsinline=1&disablekb=1&iv_load_policy=3';
        iframe.title = 'Go Green Restoration Background Video';
        iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
        iframe.style.cssText = 'border:0;width:100%;height:100%;pointer-events:none;';
        wrap.appendChild(iframe);
        scaleVideo();
        // Fade in video after a short delay to let it buffer
        setTimeout(() => { container.style.opacity = '1'; }, 1500);
      }

      scaleVideo();
      window.addEventListener('resize', scaleVideo);
      // Load the video after the page has fully loaded
      if (document.readyState === 'complete') {
        loadVideo();
      } else {
        window.addEventListener('load', loadVideo);
      }
    </script>
    <!-- Content -->
    <div class="relative z-20 max-w-7xl mx-auto px-4 py-12 lg:py-16 flex-1 flex items-center w-full">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 items-center w-full">
        <div class="max-w-2xl">
          <!-- Emergency badge -->
          <div class="inline-flex items-center gap-2 bg-brand-green/20 border border-brand-green/40 backdrop-blur-sm px-4 py-1.5 rounded-full mb-5">
            <span class="w-2 h-2 rounded-full bg-brand-green animate-pulse"></span>
            <span class="text-xs font-bold uppercase tracking-wider text-white">24/7 Emergency Restoration</span>
          </div>

          <h1 class="font-heading text-4xl lg:text-5xl xl:text-6xl font-black leading-[1.05] mb-5 drop-shadow-lg">
            Restoring Property.<br />
            Rebuilding <span class="text-brand-green">Peace of Mind.</span>
          </h1>
          <p class="text-base lg:text-lg text-white/85 mb-7 drop-shadow max-w-xl leading-relaxed">
            Water. Fire. Mold. Sewage. We restore what matters most with speed, care, and eco-friendly solutions.
          </p>

          <div class="flex flex-col sm:flex-row gap-3 mb-7">
            <a href="tel:+14697273217" class="inline-flex items-center justify-center gap-2 bg-brand-green hover:bg-brand-green-light text-white font-bold text-base px-7 py-4 rounded-full text-center transition-colors shadow-lg shadow-brand-green/30">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
              Call Now (469) 727-3217
            </a>
            <a href="/contact/" class="inline-flex items-center justify-center bg-white/10 hover:bg-white/20 text-white font-bold text-base px-7 py-4 rounded-full text-center transition-colors border border-white/30 backdrop-blur-sm">
              Get Free Estimate
            </a>
          </div>

          <!-- Trust pills row -->
          <div class="flex flex-wrap gap-2">
            <span class="inline-flex items-center gap-1.5 bg-white/10 backdrop-blur-sm border border-white/15 text-white text-xs font-medium px-3 py-1.5 rounded-full">
              <svg class="w-3.5 h-3.5 text-brand-green" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              24/7 Emergency Response
            </span>
            <span class="inline-flex items-center gap-1.5 bg-white/10 backdrop-blur-sm border border-white/15 text-white text-xs font-medium px-3 py-1.5 rounded-full">
              <svg class="w-3.5 h-3.5 text-brand-green" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
              IICRC Certified Technicians
            </span>
            <span class="inline-flex items-center gap-1.5 bg-white/10 backdrop-blur-sm border border-white/15 text-white text-xs font-medium px-3 py-1.5 rounded-full">
              <svg class="w-3.5 h-3.5 text-brand-green" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
              Insurance Claims Assistance
            </span>
            <span class="inline-flex items-center gap-1.5 bg-white/10 backdrop-blur-sm border border-white/15 text-white text-xs font-medium px-3 py-1.5 rounded-full">
              <svg class="w-3.5 h-3.5 text-brand-green" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              Eco-Friendly Methods
            </span>
            <span class="inline-flex items-center gap-1.5 bg-white/10 backdrop-blur-sm border border-white/15 text-white text-xs font-medium px-3 py-1.5 rounded-full">
              <svg class="w-3.5 h-3.5 text-brand-green" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
              Insured
            </span>
          </div>
        </div>

        <!-- Right side: Play button — hidden for now, will be re-enabled when video is ready
        <div class="hidden lg:flex justify-center items-center">
          <a href="https://www.youtube.com/watch?v=G-KfCmJHxTI" target="_blank" rel="noopener" class="group relative">
            <div class="w-28 h-28 rounded-full bg-white/15 backdrop-blur-sm border border-white/30 flex items-center justify-center transition-transform group-hover:scale-110">
              <div class="w-20 h-20 rounded-full bg-white/20 flex items-center justify-center">
                <svg class="w-10 h-10 text-white ml-1" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
              </div>
            </div>
            <p class="text-center text-xs font-bold uppercase tracking-wider text-white mt-3">Watch How We Help</p>
          </a>
        </div>
        -->
        <div class="hidden"></div>
      </div>
    </div>
  </section>

  <!-- Trust Badges floating card (overlapping hero bottom) -->
  <section class="relative bg-white pb-10 lg:pb-16">
    <div class="max-w-6xl mx-auto px-4 -mt-10 lg:-mt-12 relative z-30">
      <div class="bg-white rounded-2xl shadow-2xl border border-brand-gray-100 px-6 py-5">
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 divide-y sm:divide-y-0 sm:divide-x divide-brand-gray-100 gap-y-4">
          <div class="flex items-center gap-3 px-2 sm:px-4 py-2 sm:py-0">
            <svg class="w-7 h-7 text-brand-green flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/></svg>
            <div class="leading-tight">
              <p class="text-sm font-bold text-brand-gray-900">Insured</p>
              <p class="text-xs text-brand-gray-600">Full Coverage</p>
            </div>
          </div>
          <div class="flex items-center gap-3 px-2 sm:px-4 py-2 sm:py-0">
            <svg class="w-7 h-7 text-brand-green flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            <div class="leading-tight">
              <p class="text-sm font-bold text-brand-gray-900">IICRC Certified</p>
              <p class="text-xs text-brand-gray-600">Firm</p>
            </div>
          </div>
          <div class="flex items-center gap-3 px-2 sm:px-4 py-2 sm:py-0">
            <svg class="w-7 h-7 flex-shrink-0" viewBox="0 0 48 48"><path fill="#4285F4" d="M45.12 24.5c0-1.56-.14-3.06-.4-4.5H24v8.51h11.84c-.51 2.75-2.06 5.08-4.39 6.64v5.52h7.11c4.16-3.83 6.56-9.47 6.56-16.17z"/><path fill="#34A853" d="M24 46c5.94 0 10.92-1.97 14.56-5.33l-7.11-5.52c-1.97 1.32-4.49 2.1-7.45 2.1-5.73 0-10.58-3.87-12.31-9.07H4.34v5.7C7.96 41.07 15.4 46 24 46z"/><path fill="#FBBC05" d="M11.69 28.18C11.25 26.86 11 25.45 11 24s.25-2.86.69-4.18v-5.7H4.34C2.85 17.09 2 20.45 2 24c0 3.55.85 6.91 2.34 9.88l7.35-5.7z"/><path fill="#EA4335" d="M24 10.75c3.23 0 6.13 1.11 8.41 3.29l6.31-6.31C34.91 4.18 29.93 2 24 2 15.4 2 7.96 6.93 4.34 14.12l7.35 5.7c1.73-5.2 6.58-9.07 12.31-9.07z"/></svg>
            <div class="leading-tight">
              <p class="text-sm font-bold text-brand-gray-900">4.9 <span class="text-yellow-500">&#9733;&#9733;&#9733;&#9733;&#9733;</span></p>
              <p class="text-xs text-brand-gray-600">(500+ Reviews)</p>
            </div>
          </div>
          <div class="flex items-center gap-3 px-2 sm:px-4 py-2 sm:py-0">
            <svg class="w-7 h-7 text-brand-green flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            <div class="leading-tight">
              <p class="text-sm font-bold text-brand-gray-900">24/7</p>
              <p class="text-xs text-brand-gray-600">Rapid Response</p>
            </div>
          </div>
          <div class="flex items-center gap-3 px-2 sm:px-4 py-2 sm:py-0 col-span-2 sm:col-span-3 lg:col-span-1">
            <svg class="w-7 h-7 text-brand-green flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
            <div class="leading-tight">
              <p class="text-sm font-bold text-brand-gray-900">Preferred by Major</p>
              <p class="text-xs text-brand-gray-600">Insurance Companies</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Services Section -->
  <section class="py-16 lg:py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4">
      <div class="text-center mb-14 reveal">
        <p class="text-sm font-bold uppercase tracking-widest text-brand-green mb-3">Our Services</p>
        <h2 class="font-heading text-3xl lg:text-5xl font-black text-brand-gray-900 mb-4">Complete Restoration. Start to Finish.</h2>
        <p class="text-base lg:text-lg text-brand-gray-600 max-w-2xl mx-auto">From emergency cleanup to full reconstruction, we handle every step so you can focus on moving forward.</p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-6 stagger-children">
        {services.map((service) => (
          <a href={`/services/${service.slug}/`} class="group relative bg-white rounded-2xl overflow-hidden border border-brand-gray-100 shadow-md hover:shadow-xl transition-all flex flex-col hover:-translate-y-1 duration-300">
            <!-- Floating icon badge -->
            <div class="absolute top-4 left-4 z-10 w-14 h-14 rounded-xl bg-white shadow-lg flex items-center justify-center">
              <svg class="w-7 h-7 text-brand-green" viewBox="0 0 24 24" stroke="currentColor" set:html={serviceIconSvg[service.icon] || ''} />
            </div>
            <!-- Image -->
            <div class="aspect-[4/3] overflow-hidden bg-brand-gray-100">
              <img src={service.image} alt={service.name} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" width="900" height="675" />
            </div>
            <!-- Content -->
            <div class="p-6 flex-1 flex flex-col">
              <h3 class="font-heading text-base font-black text-brand-gray-900 uppercase tracking-wide mb-3 leading-tight">{service.name}</h3>
              <p class="text-brand-gray-600 text-sm mb-5 leading-relaxed flex-1">{service.cardDescription || `Professional ${service.shortName.toLowerCase()} services throughout Dallas-Fort Worth metroplex.`}</p>
              <span class="inline-flex items-center text-brand-green font-bold text-xs uppercase tracking-wider group-hover:gap-2 transition-all">Learn more <svg class="w-4 h-4 ml-1.5 group-hover:ml-2.5 transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg></span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Our Process Section -->
  <section class="py-16 lg:py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4">
      <div class="text-center mb-14 reveal">
        <p class="text-sm font-bold uppercase tracking-widest text-brand-green mb-3">Our Process</p>
        <h2 class="font-heading text-3xl lg:text-5xl font-black text-brand-gray-900">Restoration in 4 Simple Steps</h2>
      </div>
      <div class="relative max-w-6xl mx-auto">
        <!-- Connecting line (desktop only) -->
        <div class="hidden lg:block absolute top-7 left-[12.5%] right-[12.5%] h-px bg-brand-gray-200 z-0"></div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-10 lg:gap-6 relative z-10 stagger-children">
          <!-- Step 1: Inspect & Assess -->
          <div class="text-center">
            <div class="w-14 h-14 mx-auto rounded-full bg-brand-green text-white font-black text-lg flex items-center justify-center shadow-lg mb-6 relative z-10 ring-8 ring-white">1</div>
            <div class="w-16 h-16 mx-auto mb-5 text-brand-gray-700">
              <svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="2" class="w-full h-full">
                <rect x="16" y="10" width="32" height="44" rx="2"/>
                <path d="M26 6h12v8H26z"/>
                <path d="M22 24h12 M22 32h16 M22 40h10" stroke-linecap="round"/>
                <circle cx="44" cy="40" r="6" stroke="#2d6a2e"/>
                <path d="M41 40l2 2 4-4" stroke="#2d6a2e" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
            <h3 class="font-heading text-lg font-bold text-brand-gray-900 mb-3">Inspect &amp; Assess</h3>
            <p class="text-sm text-brand-gray-600 leading-relaxed max-w-[220px] mx-auto">We arrive quickly, inspect the damage, and create a clear restoration plan.</p>
