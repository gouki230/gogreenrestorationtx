---
import generatedImages from '../../data/compact-service-images.json';
import RealEstateLinks from '../../components/RealEstateLinks.astro';
import CompactServiceLinks from '../../components/CompactServiceLinks.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import services from '../../data/services.json';
import dfwCities from '../../data/cities-dfw-metro.json';
import ProjectPhotos from '../../components/ProjectPhotos.astro';
import { getPillarGuides } from '../../utils/internal-links';
import pillarContent from '../../data/service-pillars.json';

export function getStaticPaths() {
  return services.map((service) => ({
    params: { service: service.slug },
    props: { service },
  }));
}

const { service } = Astro.props;
const featuredGuides = getPillarGuides(service.slug);
const pillar = pillarContent[service.slug as keyof typeof pillarContent];
const dfwCitiesList = [...dfwCities].sort((a, b) => a.name.localeCompare(b.name));

const isMold = service.slug === 'mold-remediation';
const title = isMold ? 'DFW Mold Removal & Remediation Help | Go Green TX' : `${service.name} Services | Go Green Restoration TX Inc`;
const description = isMold ? 'Discuss mold removal and remediation in Dallas, Collin County and DFW. Discuss the affected materials, leak history and next steps for your home or business.' : `Professional ${service.name.toLowerCase()} services throughout the Dallas–Fort Worth Metroplex. Bonded & insured, EPA Lead-Safe certified. 24/7 emergency response. Free estimates.`;

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Services', url: '/services/' },
  { name: service.name, url: `/services/${service.slug}/` },
];

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": service.name,
  "description": description,
  "provider": {
    "@type": "LocalBusiness",
    "@id": "https://gogreenrestorationtx.com/#wylie",
    "name": "Go Green Restoration TX Inc",
    "url": "https://gogreenrestorationtx.com"
  },
  "areaServed": [
    { "@type": "AdministrativeArea", "name": "Dallas-Fort Worth Metroplex" }
  ],
  "serviceType": service.name,
  "availableChannel": {
    "@type": "ServiceChannel",
    "serviceUrl": `https://gogreenrestorationtx.com/services/${service.slug}/`,
    "servicePhone": "+1-469-727-3217"
  },
  "hoursAvailable": {
    "@type": "OpeningHoursSpecification",
    "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday","Sunday"],
    "opens": "00:00",
    "closes": "23:59"
  }
};

const otherServices = services.filter(s => s.slug !== service.slug);
const serviceIcons: Record<string, string> = {
  droplet: '💧', flame: '🔥', shield: '🛡️', 'alert-triangle': '⚠️', hammer: '🔨',
};
const serviceImages: Record<string, { src: string; alt: string }[]> = {
  'water-damage-restoration': [
    { src: '/images/site/go-green-technician-water-damage-repair.jpg', alt: 'Go Green technician performing water damage restoration' },
    { src: '/images/site/go-green-water-damage-equipment.jpg', alt: 'Professional water damage extraction equipment' },
    { src: '/images/site/go-green-water-damage-drying.jpg', alt: 'Structural drying equipment in use' },
  ],
  'fire-smoke-damage-restoration': [
    { src: '/images/site/go-green-fire-damage-cleanup.jpg', alt: 'Go Green team performing fire damage cleanup' },
    { src: '/images/site/go-green-smoke-damage-restoration.jpg', alt: 'Smoke damage restoration in progress' },
    { src: '/images/site/go-green-team-restoration-work.jpg', alt: 'Restoration team cleaning smoke damage from walls' },
  ],
  'mold-remediation': [
    { src: '/images/site/go-green-mold-remediation-ceiling.jpg', alt: 'Go Green mold remediation specialist working on ceiling' },
    { src: '/images/site/go-green-mold-removal-process.jpg', alt: 'Professional mold removal process' },
    { src: '/images/site/go-green-mold-containment.jpg', alt: 'Mold containment setup during remediation' },
  ],
  'sewage-backup-cleanup': [
    { src: '/images/site/go-green-team-packout-warehouse.jpg', alt: 'Go Green team handling sewage damage cleanup' },
    { src: '/images/site/go-green-technician-water-damage-repair.jpg', alt: 'Technician in protective gear during cleanup' },
  ],
  'construction-remodeling': [
    { src: '/images/site/go-green-commercial-restoration.jpg', alt: 'Go Green commercial restoration project' },
    { src: '/images/site/go-green-team-restoration-work.jpg', alt: 'Restoration and reconstruction team at work' },
  ],
};
const moldImage = generatedImages['mold-remediation-after-water-damage'];
const images = isMold ? [] : serviceImages[service.slug] || [];
---

<BaseLayout title={title} description={description} schema={[serviceSchema]} omitOfficeCopy={isMold}>
  <Breadcrumbs items={breadcrumbs} />

  <!-- Hero -->
  <section class="bg-gradient-to-br from-brand-brown to-brand-brown-dark text-white">
    <div class="max-w-7xl mx-auto px-4 py-16 lg:py-20">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 items-center">
        <div>
          <h1 class="font-heading text-4xl lg:text-5xl font-black mb-4">{isMold ? 'Mold removal and remediation help in Dallas–Fort Worth' : service.name}</h1>
          <p class="text-lg text-brand-warm-200 max-w-3xl mb-6">
            {isMold ? 'Mold removal and remediation in Dallas–Fort Worth can be needed when a leak leaves damaged wallboard, growth beneath cabinets or a musty room that never seems to dry. We will discuss the affected materials and moisture history, explain the next step, and identify the provider and scope before work begins.' : 'Discuss your property, the work needed, and the next step with our Wylie-based team serving Dallas–Fort Worth.'}
          </p>
          <a href="tel:+14697273217" class="inline-block bg-brand-green hover:bg-brand-green-light text-white font-bold px-8 py-4 rounded-lg transition-colors">
            Call Now: (469) 727-3217
          </a>
        </div>
        {isMold ? (<figure><img src={moldImage.src} srcset={`${moldImage.smallSrc} 640w, ${moldImage.src} 1280w`} sizes="(max-width:768px) 100vw, 600px" alt="Mold removal and remediation: generated service illustration" width={moldImage.width} height={moldImage.height} fetchpriority="high" class="w-full rounded-2xl" /><figcaption class="text-sm mt-2">Higgsfield-generated service illustration; not a completed-project photograph.</figcaption></figure>) : service.image && (
          <div class="rounded-2xl overflow-hidden shadow-2xl border-4 border-white/20 aspect-[4/3]">
            <img src={service.image} alt={service.name} class="w-full h-full object-cover" width="900" height="675" fetchpriority="high" />
          </div>
        )}
      </div>
    </div>
  </section>

  <div class="max-w-7xl mx-auto px-4 py-12 lg:py-16">
    <!-- Overview with Images -->
    <div class:list={["grid grid-cols-1 gap-12 items-center mb-16", {"lg:grid-cols-2": images.length > 0}]}>
      <div>
        <h2 class="font-heading text-2xl font-bold text-brand-gray-900 mb-4">About Our {service.name} Services</h2>
        <p class="text-brand-gray-600 leading-relaxed mb-4">
          {pillar.intro}
        </p>
      </div>
      {images.length > 0 && (
        <div class="grid grid-cols-2 gap-3">
          {images.slice(0, 2).map((img) => (
            <img src={img.src} alt={img.alt} class="rounded-xl w-full h-48 object-cover shadow-lg" loading="lazy" />
          ))}
        </div>
      )}
    </div>

    <nav aria-label="On this page" class="bg-brand-gray-50 rounded-xl p-6 mb-12">
      <p class="font-heading font-bold mb-3">On this page</p>
      <ul class="flex flex-wrap gap-x-6 gap-y-3">
        {pillar.sections.map(section => <li><a class="text-brand-brown underline" href={`#${section.id}`}>{section.title}</a></li>)}
        <li><a class="text-brand-brown underline" href="#process">Our process</a></li>
        <li><a class="text-brand-brown underline" href="#service-areas">Service areas</a></li>
        <li><a class="text-brand-brown underline" href="#questions">FAQs</a></li>
      </ul>
    </nav>
    <div class="max-w-4xl space-y-10 mb-16">
      {pillar.sections.map(section => (
        <section id={section.id} class="scroll-mt-32">
          <h2 class="font-heading text-2xl font-bold mb-4">{section.title}</h2>
          {section.paragraphs.map(paragraph => <p class="text-brand-gray-600 leading-relaxed mb-4">{paragraph}</p>)}
          {'source' in section && section.source && <a href={section.source.url} class="text-brand-brown underline">{section.source.label}</a>}
        </section>
      ))}
    </div>
    {isMold && <aside class="bg-brand-warm rounded-xl p-6 mb-12">
      <h2 class="font-heading text-2xl font-bold mb-3">Discuss your Dallas or Collin County property</h2>
      <p class="text-brand-gray-700 mb-4">Call with your city, the affected room, and any known leak history. For emergencies, we aim to arrive within one hour; we confirm current availability and arrival time for your address.</p>
      <a href="/contact/" class="text-brand-brown underline font-bold">Discuss your mold problem</a>
    </aside>}
    {isMold && <section class="max-w-4xl mb-12">
      <h2 class="font-heading text-2xl font-bold mb-4">Match the mold concern to the affected space</h2>
      <p class="text-brand-gray-600 mb-4">The room and material involved help define the work. A leaking sink may affect the cabinet and the wall behind it; a bathroom repair may require controlled access to damaged wallboard. The service pages below explain those decisions in more detail.</p>
      <ul class="list-disc pl-6 space-y-3 mb-5">
        <li><a class="text-brand-brown underline" href="/services/kitchen-cabinet-mold-removal/">Kitchen cabinet mold removal</a>: review cabinet bottoms, adjoining wall material and the status of the plumbing repair.</li>
        <li><a class="text-brand-brown underline" href="/services/bathroom-mold-removal/">Bathroom mold removal</a>: distinguish a washable surface from affected material that needs removal.</li>
        <li><a class="text-brand-brown underline" href="/services/mold-removal-behind-drywall/">Mold behind drywall</a>: plan access, containment and the handoff before the wall is closed.</li>
        <li><a class="text-brand-brown underline" href="/services/mold-remediation-after-water-damage/">Mold remediation after water damage</a>: connect the moisture history, drying work and remaining cleanup.</li>
      </ul>
      <h2 class="font-heading text-2xl font-bold mb-4">What the first conversation will establish</h2>
      <p class="text-brand-gray-600 mb-4">We will review when the problem appeared, which surfaces are affected and whether the source has been repaired. Share an existing assessment or protocol if one is available. Photos can help prepare for a visit, but they cannot establish conditions inside a closed wall or substitute for an assessment.</p>
      <p class="text-brand-gray-600">The estimate will distinguish remediation from source repairs, independent assessment or clearance, and reconstruction. Progress will be recorded, and we will explain outstanding items before new finishes cover the area.</p>
    </section>}
    {isMold && <ProjectPhotos />}

    {['mold-remediation','water-damage-restoration','construction-remodeling'].includes(service.slug) && <RealEstateLinks kind={isMold ? 'mold' : service.slug === 'water-damage-restoration' ? 'water' : 'repair'} />}

    <!-- Process Steps -->
    <div id="process" class="mb-16 scroll-mt-32">
      <h2 class="font-heading text-2xl font-bold text-brand-gray-900 mb-8">Our {service.shortName} Process</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {service.processSteps.map((step, index) => (
          <div class="bg-brand-gray-50 rounded-xl p-6">
            <div class="w-10 h-10 bg-brand-brown rounded-full flex items-center justify-center text-white font-bold mb-4">{index + 1}</div>
            <h3 class="font-heading font-bold text-lg mb-2">{step.title}</h3>
            <p class="text-brand-gray-600 text-sm">{step.description.replace(/\{city\}/g, 'Dallas–Fort Worth').replace(/\{county\}/g, 'Dallas–Fort Worth')}</p>
          </div>
        ))}
      </div>
    </div>

    <!-- Types of Damage -->
    <div class="mb-16">
      <h2 class="font-heading text-2xl font-bold text-brand-gray-900 mb-6">Types of Damage We Handle</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
        {service.damageTypes.map((type) => (
          <div class="flex items-center gap-2 bg-brand-warm-100 px-4 py-3 rounded-lg">
            <span class="text-brand-green">&#10003;</span>
            <span class="text-sm text-brand-gray-800">{type}</span>
          </div>
        ))}
      </div>
    </div>

    <!-- Service Areas -->
    <div id="service-areas" class="mb-16 scroll-mt-32">
      <h2 class="font-heading text-2xl font-bold text-brand-gray-900 mb-6">{service.name} Service Areas</h2>

      <p class="text-brand-gray-600 mb-4">We serve Dallas, Collin County, and the wider DFW metroplex. Select your city for service information and call to confirm scheduling for your address.</p>
      <h3 class="font-heading font-bold text-lg mb-4 text-brand-gray-800">DFW Metro Area</h3>
      <div class="flex flex-wrap gap-2 mb-8">
        {dfwCitiesList.map((city) => (
          <a href={`/${service.slug}/${city.slug}/`} class="text-sm px-3 py-1.5 bg-brand-gray-50 hover:bg-brand-warm-100 text-brand-gray-800 hover:text-brand-brown rounded-full border border-brand-gray-200 hover:border-brand-green-200 transition-colors">
            {city.name}
          </a>
        ))}
      </div>
    </div>

    <section class="mb-16" aria-labelledby="planning-guides">
      <h2 id="planning-guides" class="scroll-mt-40 font-heading text-2xl font-bold mb-4">Guides to help you plan your next step</h2>
      <p class="text-brand-gray-600 mb-5">Explore common questions before you arrange {service.shortName.toLowerCase()}. Each guide identifies the city it covers.</p>
      <ul class="grid sm:grid-cols-3 gap-4">{featuredGuides.map(guide => <li class="rounded-xl bg-brand-gray-50 p-5"><a class="font-bold text-brand-brown underline" href={`/resources/${guide.cluster}/${guide.slug}/`}>{guide.title}</a></li>)}</ul>
    </section>

    <!-- FAQ -->
    <div id="questions" class="mb-16 scroll-mt-32">
      <h2 class="font-heading text-2xl font-bold text-brand-gray-900 mb-6">Frequently Asked Questions</h2>
      <div class="space-y-4 max-w-3xl">
        {service.faqTemplates.map((faq) => (
          <details class="bg-brand-gray-50 rounded-xl p-6 group">
            <summary class="font-heading font-bold cursor-pointer list-none flex justify-between items-center">
              <span>{faq.question.replace(/\{city\}/g, 'Dallas–Fort Worth').replace(/\{county\}/g, 'the area')}</span>
              <svg class="w-5 h-5 text-brand-gray-600 group-open:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
            </summary>
            <p class="mt-4 text-brand-gray-600">{faq.answer.replace(/\{city\}/g, 'Dallas–Fort Worth').replace(/\{county\}/g, 'the area')}</p>
          </details>
        ))}
      </div>
    </div>

    <!-- Other Services -->
    <div class="mb-16">
      <h2 class="font-heading text-2xl font-bold text-brand-gray-900 mb-6">Other Restoration Services</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {otherServices.map((s) => (
          <a href={`/services/${s.slug}/`} class="group bg-white hover:bg-brand-gray-50 rounded-xl overflow-hidden transition-all border border-brand-gray-200 hover:border-brand-green-200 shadow-sm">
            {s.image && (
              <div class="aspect-[4/3] overflow-hidden bg-brand-gray-100">
                <img src={s.image} alt={s.name} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" width="900" height="675" />
              </div>
            )}
            <div class="p-4">
              <h3 class="font-heading font-bold text-brand-gray-900 group-hover:text-brand-brown text-sm">{s.name}</h3>
            </div>
          </a>
        ))}
      </div>
    </div>

    <!-- CTA -->
    <div class="bg-brand-brown text-white rounded-2xl p-8 lg:p-12 text-center">
      <h2 class="font-heading text-2xl lg:text-3xl font-bold mb-4">Need {service.shortName} Help?</h2>
      <p class="text-brand-warm-200 mb-6 max-w-2xl mx-auto">Contact us 24/7 for emergency {service.shortName.toLowerCase()} services. Free estimates, insurance claims assistance, and eco-friendly methods.</p>
      <div class="flex flex-col sm:flex-row justify-center gap-4">
        <a href="tel:+14697273217" class="bg-brand-green hover:bg-brand-green-light font-bold px-8 py-4 rounded-lg transition-colors">Call (469) 727-3217</a>
        <a href="/contact/" class="bg-white/10 hover:bg-white/20 font-bold px-8 py-4 rounded-lg transition-colors border border-white/30">Get Free Estimate</a>
      </div>
    </div>
  </div>
  {isMold && <p id="mold-service-provider" class="max-w-7xl mx-auto px-4 py-4 text-sm text-brand-gray-600">Go Green Restoration TX Inc welcomes mold projects of any size. While our Texas mold remediation license application is pending, work requiring a license is referred to appropriately licensed partner companies. The provider and scope of work are identified before work begins. Independent assessment and clearance are separate services.</p>}
  <CompactServiceLinks service={service.slug} />
</BaseLayout>
