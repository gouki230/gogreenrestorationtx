---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Thank You | Go Green Restoration TX"
  description="Thank you for contacting Go Green Restoration TX. Our team will follow up about your service request."
  noindex={true}
>
  <section class="bg-brand-warm px-4 py-16 sm:py-24">
    <div class="max-w-2xl mx-auto bg-white rounded-2xl border border-brand-warm-200 p-8 sm:p-12 text-center shadow-sm">
      <div class="mx-auto mb-6 flex h-16 w-16 items-center justify-center rounded-full bg-brand-green text-white" aria-hidden="true">
        <svg class="h-8 w-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="m5 12 4 4L19 6" /></svg>
      </div>
      <h1 class="font-heading text-3xl sm:text-4xl font-black text-brand-gray-900 mb-4">Thank you for reaching out!</h1>
      <p class="text-lg text-brand-gray-600 leading-relaxed">Our team will follow up using the contact details you provided to discuss your request and next steps.</p>
      <p class="mt-4 text-brand-gray-600">Your request does not confirm an appointment. We'll confirm availability with you directly.</p>
      <div class="mt-8 rounded-xl bg-brand-warm p-6">
        <h2 class="font-heading text-xl font-bold text-brand-gray-900 mb-2">Need urgent help?</h2>
        <p class="text-brand-gray-600 mb-4">For an active restoration emergency, please call our team directly.</p>
        <a href="tel:+14697273217" class="inline-block bg-brand-green hover:bg-brand-green-light text-white font-bold px-6 py-3 rounded-lg transition-colors">Call (469) 727-3217</a>
      </div>
      <a href="/" class="inline-block mt-8 font-bold text-brand-brown underline underline-offset-4 hover:text-brand-green">Return to homepage</a>
    </div>
  </section>
</BaseLayout>
