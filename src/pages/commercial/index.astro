---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import page from '../../data/commercial-hub-editorial.json';
import images from '../../data/compact-service-images.json';
const image = images['emergency-water-extraction'];
const canonical = `https://gogreenrestorationtx.com${page.existingOwner}`;
const schema = {'@context':'https://schema.org','@type':'WebPage',name:page.heading,url:canonical,description:page.description};
---
<BaseLayout title={page.title} description={page.description} canonical={canonical} omitOfficeCopy={true} schema={[schema]}>
  <Breadcrumbs items={[{name:'Home',url:'/'},{name:'Commercial',url:'/commercial/'},...(page.existingOwner !== '/commercial/' ? [{name:page.heading,url:page.existingOwner}] : [])]} />
  <article class="commercial-owner max-w-5xl mx-auto px-4 py-10">
    <h1 class="font-heading text-4xl lg:text-5xl font-extrabold mb-6">{page.heading}</h1>
    <p class="text-lg mb-6">{page.intro}</p>
    <div class="flex flex-col sm:flex-row gap-3 mb-8">
      <a href="tel:+14697273217" class="bg-brand-green text-white font-bold px-6 py-4 rounded-lg text-center">Call (469) 727-3217</a>
      <a href="/contact/" class="bg-brand-brown text-white font-bold px-6 py-4 rounded-lg text-center">{page.ctaLabel}</a>
    </div>
    <figure class="mb-10">
      <img src={image.src} srcset={`${image.smallSrc} 640w, ${image.src} 1280w`} sizes="(max-width:640px) 100vw, 960px" width={image.width} height={image.height} alt={`${page.heading}: generated illustration of water-damaged interior restoration work`} fetchpriority="high" class="w-full rounded-xl" />
      <figcaption class="text-sm mt-2">Higgsfield-generated service illustration; not a photograph of a local project.</figcaption>
    </figure>
    {page.sections.map(section => <section><h2>{section.heading}</h2>{section.paragraphs.map(text => <p>{text}</p>)}{section.bullets?.length > 0 && <ul>{section.bullets.map(text => <li>{text}</li>)}</ul>}</section>)}

    <section><h2>Commercial services and property planning</h2><ul>{page.topicOwners.map(item => <li><a href={`/commercial/${item.slug}/`}>{item.label}</a><p>{item.summary}</p></li>)}
      <li><a href={page.secondaryOwner.path}>{page.secondaryOwner.label}</a></li></ul></section>
    <div class="bg-brand-gray-50 p-6 rounded-xl"><a href="/contact/" class="underline font-bold">{page.ctaLabel}</a></div>
  </article>
</BaseLayout>
<style>
.commercial-owner section{margin-bottom:2rem}
.commercial-owner h2{font-size:1.5rem;font-weight:700;line-height:1.3;margin-bottom:1rem}
.commercial-owner section p{line-height:1.8;margin-bottom:1rem}
.commercial-owner ul{list-style:disc;padding-left:1.4rem}
.commercial-owner li{margin-bottom:.6rem}
.commercial-owner section a{text-decoration:underline;color:#775130}
@media(max-width:480px){.commercial-owner h1{font-size:2.1rem}}
</style>
