---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';

const title = 'Commercial Restoration Services | HOA & Property Management | Go Green Restoration';
const description = 'Specialized restoration services for HOAs, property managers, and apartment buildings in Dallas-Fort Worth Counties. Preferred vendor programs, portfolio pricing, 24/7 emergency.';
const breadcrumbs = [{ name: 'Home', url: '/' }, { name: 'Commercial', url: '/commercial/' }];
---

<BaseLayout title={title} description={description}>
  <Breadcrumbs items={breadcrumbs} />

  <section class="bg-gradient-to-br from-brand-brown to-brand-brown-dark text-white">
    <div class="max-w-7xl mx-auto px-4 py-16 lg:py-20">
      <h1 class="font-heading text-4xl lg:text-5xl font-extrabold mb-4">Commercial & Multi-Unit Restoration</h1>
      <p class="text-lg text-brand-warm-200 max-w-3xl mb-6">Specialized restoration services for HOAs, property managers, and apartment building owners throughout Dallas-Fort Worth metroplex.</p>
      <a href="/contact/" class="inline-block bg-brand-green hover:bg-brand-green-light text-white font-bold px-8 py-4 rounded-lg transition-colors">Schedule a Property Assessment</a>
    </div>
  </section>

  <div class="max-w-7xl mx-auto px-4 py-12">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-12">
      <a href="/commercial/hoa-restoration-services/" class="group bg-brand-gray-50 hover:bg-brand-warm-100 rounded-xl p-8 transition-all hover:shadow-lg border border-transparent hover:border-brand-green-200">
        <div class="text-4xl mb-4">🏢</div>
        <h2 class="font-heading text-2xl font-bold text-brand-gray-900 group-hover:text-brand-brown mb-3">HOA Restoration Services</h2>
        <p class="text-brand-gray-600 mb-4">Multi-unit damage response, common area restoration, HOA board communication, insurance coordination for associations, compliance with CC&Rs, and preferred vendor programs.</p>
        <ul class="text-sm text-brand-gray-600 space-y-1 mb-4">
          <li>&#10003; Multi-unit emergency response</li>
          <li>&#10003; Board communication & documentation</li>
          <li>&#10003; CC&R compliance</li>
          <li>&#10003; Preferred vendor programs</li>
        </ul>
        <span class="text-brand-brown font-medium group-hover:underline">Learn more &rarr;</span>
      </a>
      <a href="/commercial/property-management-restoration/" class="group bg-brand-gray-50 hover:bg-brand-warm-100 rounded-xl p-8 transition-all hover:shadow-lg border border-transparent hover:border-brand-green-200">
        <div class="text-4xl mb-4">🏗️</div>
        <h2 class="font-heading text-2xl font-bold text-brand-gray-900 group-hover:text-brand-brown mb-3">Property Management Restoration</h2>
        <p class="text-brand-gray-600 mb-4">Tenant displacement management, multi-unit coordination, property manager reporting, recurring maintenance contracts, and 24/7 emergency response for managed properties.</p>
        <ul class="text-sm text-brand-gray-600 space-y-1 mb-4">
          <li>&#10003; Tenant communication support</li>
          <li>&#10003; Multi-property portfolio pricing</li>
          <li>&#10003; Detailed damage reporting</li>
          <li>&#10003; Recurring maintenance contracts</li>
        </ul>
        <span class="text-brand-brown font-medium group-hover:underline">Learn more &rarr;</span>
      </a>
      <a href="/commercial/commercial-properties/" class="group bg-brand-gray-50 hover:bg-brand-warm-100 rounded-xl p-8 transition-all hover:shadow-lg border border-transparent hover:border-brand-green-200">
        <div class="text-4xl mb-4">🏬</div>
        <h2 class="font-heading text-2xl font-bold text-brand-gray-900 group-hover:text-brand-brown mb-3">Commercial Properties</h2>
        <p class="text-brand-gray-600 mb-4">Restoration for office buildings, retail spaces, mixed-use developments, warehouses, and other commercial properties — designed to minimize business disruption.</p>
        <ul class="text-sm text-brand-gray-600 space-y-1 mb-4">
          <li>&#10003; After-hours scheduling</li>
          <li>&#10003; Contained work zones</li>
          <li>&#10003; Carrier &amp; adjuster coordination</li>
          <li>&#10003; Code-compliant restoration</li>
        </ul>
        <span class="text-brand-brown font-medium group-hover:underline">Learn more &rarr;</span>
      </a>
    </div>

    <div class="bg-brand-brown text-white rounded-2xl p-8 lg:p-12 text-center">
      <h2 class="font-heading text-2xl lg:text-3xl font-bold mb-4">Managing Multiple Properties?</h2>
      <p class="text-brand-warm-200 mb-6 max-w-2xl mx-auto">Ask about our preferred vendor programs and portfolio pricing for HOAs and property management companies.</p>
      <a href="/contact/" class="inline-block bg-brand-green hover:bg-brand-green-light font-bold px-8 py-4 rounded-lg transition-colors">Schedule a Property Assessment</a>
    </div>
  </div>
</BaseLayout>
