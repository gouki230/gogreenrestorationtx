---
import topics from '../../../utils/commercial-expansion-topics';
import cities from '../../../utils/commercial-service-cities';
import {commercialCityCopies as copies, isCommercialCityAvailable} from '../../../utils/commercial-city-editorial';
import CommercialExpansionPage from '../../../components/CommercialExpansionPage.astro';
export function getStaticPaths() {
  const topic = topics.find(item => item.slug === 'property-management-restoration')!;
  return cities.filter(city => isCommercialCityAvailable(topic.slug,city.slug) && copies[`${topic.slug}/${city.slug}`]).map(city => ({params:{city:city.slug},props:{topic,city,copy:copies[`${topic.slug}/${city.slug}`]}}));
}
const {topic,city,copy} = Astro.props;
---
<CommercialExpansionPage topic={topic} city={city} copy={copy} />
