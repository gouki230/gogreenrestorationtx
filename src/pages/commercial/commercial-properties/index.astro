---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import services from '../../../data/services.json';
import dfwCities from '../../../data/cities-dfw-metro.json';

const title = 'Commercial Property Restoration | Go Green Restoration Inc';
const description = 'Restoration services for commercial buildings, offices, retail, and mixed-use properties in Dallas-Fort Worth Counties. Fast response, minimal disruption, insurance coordination.';
const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Commercial', url: '/commercial/' },
  { name: 'Commercial Properties', url: '/commercial/commercial-properties/' },
];

const dfwCitiesList = dfwCities.sort((a, b) => a.name.localeCompare(b.name));

const serviceIconSvg: Record<string, string> = {
  droplet: '<path d="M12 2.5c0 0-6.5 7-6.5 12.5a6.5 6.5 0 1013 0c0-5.5-6.5-12.5-6.5-12.5z" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" fill="none"/>',
  flame: '<path d="M12 2.5s-1 3 1 5.5c1.5 1.875 4 3.5 4 7a5 5 0 11-10 0c0-3.5 2-5 2-8C9 3.5 12 2.5 12 2.5z" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" fill="none"/>',
  mold: '<circle cx="12" cy="12" r="3" stroke-width="1.8" fill="none"/><circle cx="6" cy="8" r="1.5" fill="currentColor"/><circle cx="18" cy="9" r="1.5" fill="currentColor"/><circle cx="7" cy="17" r="1.5" fill="currentColor"/><circle cx="17" cy="16" r="1.5" fill="currentColor"/>',
  pipe: '<path d="M4 9h6V5h4v4h6v6h-6v4h-4v-4H4z" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" fill="none"/>',
  house: '<path d="M3 11l9-7 9 7v9a1 1 0 01-1 1h-5v-7h-6v7H4a1 1 0 01-1-1v-9z" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" fill="none"/>',
};

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Commercial Property Restoration",
    "provider": { "@type": "Organization", "name": "Go Green Restoration Inc", "url": "https://gogreenrestorationtx.com" },
    "areaServed": [
      { "@type": "AdministrativeArea", "name": "DFW Metro Area" },
      { "@type": "AdministrativeArea", "name": "DFW Metro Area" },
    ],
    "serviceType": "Commercial Property Restoration",
    "description": description,
  },
];
---

<BaseLayout title={title} description={description} schema={schema} breadcrumbs={breadcrumbs}>
  <Breadcrumbs items={breadcrumbs} />

  <!-- Hero -->
  <section class="bg-gradient-to-br from-brand-brown to-brand-brown-dark text-white">
    <div class="max-w-7xl mx-auto px-4 py-16 lg:py-20">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 items-center">
        <div>
          <p class="text-sm font-bold uppercase tracking-widest text-brand-warm-200 mb-3">Commercial Property Solutions</p>
          <h1 class="font-heading text-4xl lg:text-5xl font-black mb-4 leading-tight">Restoration for Commercial Properties</h1>
          <p class="text-lg text-brand-warm-200 max-w-3xl mb-6">Fast, professional restoration for offices, retail spaces, mixed-use buildings, warehouses, and other commercial properties across Dallas-Fort Worth metroplex. We minimize disruption so you can stay open for business.</p>
          <div class="flex flex-col sm:flex-row gap-3">
            <a href="tel:+14697273217" class="inline-flex items-center justify-center gap-2 bg-brand-green hover:bg-brand-green-light text-white font-bold px-7 py-4 rounded-full transition-colors">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
              Call (469) 727-3217
            </a>
            <a href="/contact/" class="inline-flex items-center justify-center bg-white/10 hover:bg-white/20 text-white font-bold px-7 py-4 rounded-full border border-white/30 transition-colors">Request Estimate</a>
          </div>
        </div>
        <div class="hidden lg:block">
          <img src="/images/services/hoa-restoration.jpg" alt="Commercial building exterior" class="w-full rounded-2xl shadow-2xl object-cover aspect-[5/4]" loading="eager" width="900" height="720" />
        </div>
      </div>
    </div>
  </section>

  <div class="max-w-7xl mx-auto px-4 py-12 lg:py-16">
    <!-- Overview -->
    <div class="max-w-3xl mb-12">
      <h2 class="font-heading text-2xl lg:text-3xl font-black text-brand-gray-900 mb-4">Restoration That Keeps Your Business Running</h2>
      <p class="text-brand-gray-600 leading-relaxed mb-4">When water, fire, mold, or sewage damage hits a commercial property, every hour offline costs money. Go Green Restoration provides rapid-response restoration for commercial buildings — with after-hours scheduling, containment that lets adjacent areas stay operational, and clear communication with facility managers, owners, and insurance carriers.</p>
      <p class="text-brand-gray-600 leading-relaxed">From single-tenant offices to large mixed-use developments, our IICRC-certified technicians deliver fast, code-compliant restoration backed by full documentation for your claim.</p>
    </div>

    <!-- Property types we serve -->
    <div class="mb-12">
      <h2 class="font-heading text-2xl lg:text-3xl font-black text-brand-gray-900 mb-6">Commercial Properties We Serve</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="bg-brand-warm-50 rounded-xl p-6 border border-brand-gray-100">
          <div class="w-12 h-12 mb-3 text-brand-green"><svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" class="w-full h-full"><rect x="8" y="10" width="32" height="32"/><path d="M14 16h6v6h-6z M28 16h6v6h-6z M14 28h6v6h-6z M28 28h6v6h-6z"/></svg></div>
          <h3 class="font-heading font-bold text-lg mb-2">Office Buildings</h3>
          <p class="text-sm text-brand-gray-600">Single-tenant and multi-tenant office spaces, professional buildings, and executive suites.</p>
        </div>
        <div class="bg-brand-warm-50 rounded-xl p-6 border border-brand-gray-100">
          <div class="w-12 h-12 mb-3 text-brand-green"><svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" class="w-full h-full"><path d="M6 18h36v22H6z"/><path d="M6 18l4-8h28l4 8 M18 40v-12h12v12"/></svg></div>
          <h3 class="font-heading font-bold text-lg mb-2">Retail &amp; Storefronts</h3>
          <p class="text-sm text-brand-gray-600">Shops, showrooms, salons, and ground-floor retail with after-hours scheduling to protect business hours.</p>
        </div>
        <div class="bg-brand-warm-50 rounded-xl p-6 border border-brand-gray-100">
          <div class="w-12 h-12 mb-3 text-brand-green"><svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" class="w-full h-full"><rect x="6" y="10" width="20" height="32"/><rect x="26" y="20" width="16" height="22"/><path d="M12 18h2 M18 18h2 M12 26h2 M18 26h2 M12 34h2 M18 34h2 M32 26h2 M38 26h2 M32 32h2 M38 32h2"/></svg></div>
          <h3 class="font-heading font-bold text-lg mb-2">Mixed-Use Buildings</h3>
          <p class="text-sm text-brand-gray-600">Buildings combining retail, office, and residential — coordinated restoration across all units.</p>
        </div>
        <div class="bg-brand-warm-50 rounded-xl p-6 border border-brand-gray-100">
          <div class="w-12 h-12 mb-3 text-brand-green"><svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" class="w-full h-full"><path d="M6 20l18-10 18 10v22H6z"/><rect x="20" y="28" width="8" height="14"/><path d="M12 24h6v6h-6z M30 24h6v6h-6z"/></svg></div>
          <h3 class="font-heading font-bold text-lg mb-2">Warehouses &amp; Industrial</h3>
          <p class="text-sm text-brand-gray-600">Large-scale water extraction, drying, and structural restoration for warehouses and industrial facilities.</p>
        </div>
      </div>
    </div>

    <!-- Services -->
    <div class="mb-12">
      <h2 class="font-heading text-2xl lg:text-3xl font-black text-brand-gray-900 mb-6">Restoration Services for Commercial Properties</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4">
        {services.map((s) => (
          <a href={`/services/${s.slug}/`} class="group bg-white rounded-xl p-5 border border-brand-gray-100 shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all">
            <div class="w-10 h-10 mb-3 text-brand-green">
              <svg viewBox="0 0 24 24" stroke="currentColor" class="w-full h-full" set:html={serviceIconSvg[s.icon] || ''} />
            </div>
            <h3 class="font-heading font-bold text-sm mb-2">{s.name}</h3>
            <p class="text-xs text-brand-gray-600 leading-relaxed">Commercial-grade {s.shortName.toLowerCase()} response sized for offices, retail, and mixed-use buildings.</p>
          </a>
        ))}
      </div>
    </div>

    <!-- Why us -->
    <div class="mb-12">
      <h2 class="font-heading text-2xl lg:text-3xl font-black text-brand-gray-900 mb-6">Why Commercial Property Owners Choose Go Green</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="bg-brand-warm-50 rounded-xl p-6">
          <h3 class="font-heading font-bold text-lg mb-2 text-brand-gray-900">Minimal Business Disruption</h3>
          <p class="text-sm text-brand-gray-600">After-hours and weekend scheduling, contained work zones, and clear signage so customers and tenants stay informed.</p>
        </div>
        <div class="bg-brand-warm-50 rounded-xl p-6">
          <h3 class="font-heading font-bold text-lg mb-2 text-brand-gray-900">Insurance &amp; Carrier Coordination</h3>
          <p class="text-sm text-brand-gray-600">We work directly with commercial insurance carriers and provide the documentation, photos, and scope of work your claims require.</p>
        </div>
        <div class="bg-brand-warm-50 rounded-xl p-6">
          <h3 class="font-heading font-bold text-lg mb-2 text-brand-gray-900">Code-Compliant Restoration</h3>
          <p class="text-sm text-brand-gray-600">All work meets Texas building codes, ADA requirements where applicable, and your local jurisdiction's commercial standards.</p>
        </div>
        <div class="bg-brand-warm-50 rounded-xl p-6">
          <h3 class="font-heading font-bold text-lg mb-2 text-brand-gray-900">Single Point of Contact</h3>
          <p class="text-sm text-brand-gray-600">One project manager handles your entire restoration — communicating with facility managers, owners, tenants, and insurance adjusters.</p>
        </div>
      </div>
    </div>

    <!-- Service Areas -->
    <div class="mb-12">
      <h2 class="font-heading text-2xl lg:text-3xl font-black text-brand-gray-900 mb-6">Commercial Restoration Service Areas</h2>
      <h3 class="font-heading font-bold text-lg mb-4 text-brand-gray-800">DFW Metro Area</h3>
      <div class="flex flex-wrap gap-2 mb-8">
        {dfwCitiesList.slice(0, 60).map((city) => (
          <span class="text-sm px-3 py-1.5 bg-brand-gray-50 text-brand-gray-800 rounded-full border border-brand-gray-200">{city.name}</span>
        ))}
      </div>
      <h3 class="font-heading font-bold text-lg mb-4 text-brand-gray-800">DFW Metro Area</h3>
      <div class="flex flex-wrap gap-2">
        {dfwCitiesList.map((city) => (
          <span class="text-sm px-3 py-1.5 bg-brand-gray-50 text-brand-gray-800 rounded-full border border-brand-gray-200">{city.name}</span>
        ))}
      </div>
    </div>

    <!-- CTA -->
    <div class="bg-brand-brown text-white rounded-2xl p-8 lg:p-12 text-center">
      <h2 class="font-heading text-2xl lg:text-3xl font-black mb-4">Commercial Property Damage? Call Now.</h2>
      <p class="text-brand-warm-200 mb-6 max-w-2xl mx-auto">24/7 emergency response for commercial buildings across the DFW Metro Area. Bonded and insured.</p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a href="tel:+14697273217" class="inline-block bg-brand-green hover:bg-brand-green-light font-bold px-8 py-4 rounded-full transition-colors">Call (469) 727-3217</a>
        <a href="/contact/" class="inline-block bg-white/10 hover:bg-white/20 text-white border border-white/30 font-bold px-8 py-4 rounded-full transition-colors">Request Estimate</a>
      </div>
    </div>
  </div>
</BaseLayout>
