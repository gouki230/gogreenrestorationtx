---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ReviewSources from '../components/ReviewSources.astro';
const title = 'Customer Reviews | Go Green Restoration TX Inc';
const description = "Explore customer reviews of Go Green Restoration through the company's Google profiles.";
const breadcrumbs = [{ name: 'Home', url: '/' }, { name: 'Reviews', url: '/reviews/' }];
---
<BaseLayout title={title} description={description}>
  <Breadcrumbs items={breadcrumbs} />
  <section class="bg-gradient-to-br from-brand-brown to-brand-brown-dark text-white">
    <div class="max-w-7xl mx-auto px-4 py-16">
      <h1 class="font-heading text-4xl lg:text-5xl font-black mb-4">What Go Green Restoration customers say</h1>
      <p class="text-lg text-brand-warm-200">Read customer feedback and explore our work.</p>
    </div>
  </section>
  <div class="max-w-7xl mx-auto px-4 py-12">
    <ReviewSources />
    <div class="mt-10 flex flex-wrap gap-5">
      <a href="/gallery/" class="font-bold text-brand-brown underline">See our Texas project photos</a>
      <a href="/contact/" class="font-bold text-brand-brown underline">Request a free estimate</a>
    </div>
  </div>
</BaseLayout>
