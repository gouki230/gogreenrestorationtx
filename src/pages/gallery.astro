---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ProjectPhotos from '../components/ProjectPhotos.astro';
const title = 'Texas Mold Project Photos | Go Green Restoration';
const description = 'View photos from Go Green Restoration mold remediation projects in Dallas and Arlington, Texas, including containment and work areas.';
const breadcrumbs = [{ name: 'Home', url: '/' }, { name: 'Gallery', url: '/gallery/' }];
const schema = { '@context': 'https://schema.org', '@type': 'ImageGallery', name: title, description, url: 'https://gogreenrestorationtx.com/gallery/' };
---
<BaseLayout title={title} description={description} schema={[schema]}>
  <Breadcrumbs items={breadcrumbs} />
  <section class="bg-gradient-to-br from-brand-brown to-brand-brown-dark text-white">
    <div class="max-w-7xl mx-auto px-4 py-16">
      <h1 class="font-heading text-4xl lg:text-5xl font-black mb-4">Our Texas project photos</h1>
      <p class="text-lg text-brand-warm-200">A look at our work in Dallas and Arlington, from containment barriers to opened walls and equipment.</p>
    </div>
  </section>
  <div class="max-w-7xl mx-auto px-4 py-12">
    <ProjectPhotos />
    <div class="bg-brand-warm rounded-xl p-8">
      <h2 class="font-heading text-2xl font-bold mb-4">Discuss your mold cleanup needs</h2>
      <p class="text-brand-gray-700 mb-4">Our current mold cleanup service covers areas of less than 25 contiguous square feet. We refer work outside that scope to a TDLR-licensed remediator.</p>
      <a href="/services/mold-remediation/" class="font-bold text-brand-brown underline">Explore our mold cleanup service</a>
    </div>
  </div>
</BaseLayout>
