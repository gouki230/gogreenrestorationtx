---
import reviews from '../data/featured-reviews.json';
---
<div class="customer-reviews">
  <p class="review-intro">Selected customer feedback from Go Green Restoration’s public profiles.</p>
  <div class="review-grid">
    {reviews.map(review => (
      <figure class="review-card">
        <div class="review-top"><span class="quote-mark" aria-hidden="true">“</span><span class="review-type">Customer feedback</span></div>
        <blockquote><p>{review.quote}</p></blockquote>
        <figcaption>
          <span class="review-avatar" aria-hidden="true">{review.author.split(' ').map(part => part[0]).slice(0,2).join('')}</span>
          <span><strong>{review.author}</strong><span class="review-platform">{review.platform}{review.excerpt ? ' · Excerpt' : ''}</span></span>
        </figcaption>
        <a class="review-source" href={review.source} target="_blank" rel="noopener noreferrer">Read review source <span aria-hidden="true">↗</span><span class="sr-only"> for {review.author}</span></a>
      </figure>
    ))}
  </div>
</div>
<style>
  .review-intro{font-size:1.125rem;line-height:1.7;color:#59635c;max-width:42rem;margin:0 0 2rem}
  .review-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1.25rem}
  .review-card{margin:0;display:flex;flex-direction:column;padding:1.75rem;background:#fafbf8;border:1px solid #e0e6dc;border-radius:1rem;box-shadow:0 5px 18px #203b2810}
  .review-top{display:flex;align-items:center;justify-content:space-between;margin-bottom:1rem}
  .quote-mark{font:700 3.5rem/1 Georgia,serif;color:#3d6535;height:2rem}
  .review-type{font-size:.7rem;letter-spacing:.09em;text-transform:uppercase;font-weight:700;color:#62745d}
  blockquote{margin:0 0 1.75rem;flex:1}blockquote p{font-size:1.14rem;line-height:1.7;color:#26352b;margin:0}
  figcaption{display:flex;align-items:center;gap:.75rem;padding-top:1.25rem;border-top:1px solid #e0e6dc}
  figcaption strong{display:block;font-size:.94rem;color:#243a29}.review-platform{display:block;font-size:.72rem;line-height:1.5;color:#687268;margin-top:.2rem}
  .review-avatar{display:flex;align-items:center;justify-content:center;flex-shrink:0;width:2.5rem;height:2.5rem;border-radius:50%;background:#e9efdf;color:#3b5a30;font-weight:700;font-size:.85rem}
  .review-source{font-size:.8rem;color:#365d2e;margin-top:1rem;text-underline-offset:4px;text-decoration:underline;align-self:flex-start}.review-source:hover{color:#172f14}.review-source:focus-visible{outline:2px solid #365d2e;outline-offset:5px}
  @media(max-width:960px){.review-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media(max-width:600px){.review-grid{grid-template-columns:1fr;gap:1rem}.review-card{padding:1.5rem}blockquote{margin-bottom:1.5rem}.review-intro{font-size:1rem}}
</style>
