---
/**
 * Google Maps embed centered on LA + Fort Worth Counties.
 * Uses the Embed API (no key required for basic embeds).
 */
---

<div class="max-w-4xl mx-auto mb-10 rounded-2xl overflow-hidden shadow-lg border border-brand-warm-200">
  <iframe
    src="https://www.google.com/maps/embed?pb=!1m14!1m12!1m3!1d423286.2742390794!2d-118.6919205!3d34.0207305!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!5e0!3m2!1sen!2sus!4v1"
    width="100%"
    height="400"
    style="border:0;"
    allowfullscreen=""
    loading="lazy"
    referrerpolicy="no-referrer-when-downgrade"
    title="Go Green Restoration Service Areas - Dallas-Fort Worth metroplex, Texas"
    class="w-full"
  ></iframe>
</div>
