      <!-- Services -->
      <div>
        <h3 class="font-heading font-bold text-lg mb-4">Services</h3>
        <ul class="space-y-2">
          <li><a href="/services/water-damage-restoration/" class="text-brand-gray-200 hover:text-white text-sm transition-colors">Water Damage Restoration</a></li>
          <li><a href="/services/fire-smoke-damage-restoration/" class="text-brand-gray-200 hover:text-white text-sm transition-colors">Fire & Smoke Damage</a></li>
          <li><a href="/services/mold-remediation/" class="text-brand-gray-200 hover:text-white text-sm transition-colors">Mold Remediation</a></li>
          <li><a href="/services/sewage-backup-cleanup/" class="text-brand-gray-200 hover:text-white text-sm transition-colors">Sewage Backup Cleanup</a></li>
          <li><a href="/services/construction-remodeling/" class="text-brand-gray-200 hover:text-white text-sm transition-colors">Construction & Remodeling</a></li>
        </ul>
      </div>

      <!-- Commercial & Locations -->
      <div>
        <h3 class="font-heading font-bold text-lg mb-4">Service Areas</h3>
        <ul class="space-y-2">
          <li><a href="/locations/dfw-metro/" class="text-brand-gray-200 hover:text-white text-sm transition-colors">DFW Metro Area</a></li>
        </ul>
        <h3 class="font-heading font-bold text-lg mb-4 mt-6">Commercial</h3>
        <ul class="space-y-2">
          <li><a href="/commercial/hoa-restoration-services/" class="text-brand-gray-200 hover:text-white text-sm transition-colors">HOA Services</a></li>
          <li><a href="/commercial/property-management-restoration/" class="text-brand-gray-200 hover:text-white text-sm transition-colors">Property Management</a></li>
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h3 class="font-heading font-bold text-lg mb-4">24/7 Emergency</h3>
        <a href="tel:+14697273217" class="text-2xl font-bold text-brand-orange hover:text-brand-orange-light transition-colors block mb-4">
          (469) 727-3217
        </a>
        <div class="text-brand-gray-200 text-sm space-y-3 mb-4">
          <div>
            <p class="font-medium text-white">Dallas-Fort Worth Office</p>
            <p>1902 Parker Rd</p>
            <p>Wylie, TX 75098</p>
          </div>
        </div>
        <ul class="space-y-2">
          <li><a href="/contact/" class="text-brand-gray-200 hover:text-white text-sm transition-colors">Contact Us</a></li>
          <li><a href="/about/" class="text-brand-gray-200 hover:text-white text-sm transition-colors">About Us</a></li>
          <li><a href="/resources/" class="text-brand-gray-200 hover:text-white text-sm transition-colors">Resources</a></li>
          <li><a href="/reviews/" class="text-brand-gray-200 hover:text-white text-sm transition-colors">Reviews</a></li>
          <li><a href="/insurance/" class="text-brand-gray-200 hover:text-white text-sm transition-colors">Insurance Claims</a></li>
        </ul>
      </div>
    </div>
  </div>

  <!-- Bottom Bar -->
  <div class="border-t border-white/10">
    <div class="max-w-7xl mx-auto px-4 py-6 flex flex-col sm:flex-row justify-between items-center gap-4">
      <p class="text-brand-gray-200 text-sm">
        &copy; {currentYear} Go Green Restoration Inc. All rights reserved.
      </p>
      <div class="flex gap-4 text-sm">
        <a href="/privacy/" class="text-brand-gray-200 hover:text-white transition-colors">Privacy Policy</a>
        <a href="/terms/" class="text-brand-gray-200 hover:text-white transition-colors">Terms of Service</a>
        <a href="/sitemap/" class="text-brand-gray-200 hover:text-white transition-colors">Sitemap</a>
      </div>
    </div>
  </div>
</footer>
