---
const navItems = [
  {
    label: 'Services',
    href: '/services/',
    children: [
      { label: 'Water Damage Restoration', href: '/services/water-damage-restoration/' },
      { label: 'Fire & Smoke Damage', href: '/services/fire-smoke-damage-restoration/' },
      { label: 'Mold Remediation', href: '/services/mold-remediation/' },
      { label: 'Sewage Backup Cleanup', href: '/services/sewage-backup-cleanup/' },
      { label: 'Reconstruction & Remodeling', href: '/services/construction-remodeling/' },
    ],
  },
  {
    label: 'Commercial',
    href: '/commercial/',
    children: [
      { label: 'Commercial Properties', href: '/commercial/commercial-properties/' },
      { label: 'HOA Restoration', href: '/commercial/hoa-restoration-services/' },
      { label: 'Property Management', href: '/commercial/property-management-restoration/' },
    ],
  },
  { label: 'About', href: '/about/' },
  {
    label: 'Service Areas',
    href: '/locations/',
    children: [
      { label: 'DFW Metro Area', href: '/locations/dfw-metro/' },
      { label: 'DFW Metro Area', href: '/locations/dfw-metro/' },
    ],
  },
  { label: 'Resources', href: '/resources/' },
  { label: 'Contact', href: '/contact/' },
];
---

<header class="bg-brand-gray-900 sticky top-0 z-50 shadow-lg">
  <!-- Top Info Bar -->
  <div class="bg-black/40 text-white text-sm border-b border-white/5">
    <div class="max-w-7xl mx-auto px-4 py-2 flex justify-center items-center gap-6 flex-wrap">
      <span class="inline-flex items-center gap-2">
        <svg class="w-4 h-4 text-brand-green" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        24/7 Emergency Service
      </span>
      <span class="text-brand-green hidden sm:inline">•</span>
      <span class="inline-flex items-center gap-2">
        <svg class="w-4 h-4 text-brand-green" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
        TX License #TODO
      </span>
      <span class="text-brand-green hidden sm:inline">•</span>
      <a href="tel:+14697273217" class="inline-flex items-center gap-2 font-bold hover:text-brand-green transition-colors">
        <svg class="w-4 h-4 text-brand-green" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
        (469) 727-3217
      </a>
    </div>
  </div>

  <!-- Main Nav -->
  <nav class="max-w-7xl mx-auto px-4 py-3">
    <div class="flex items-center justify-between gap-6">
      <!-- Logo -->
      <a href="/" class="flex items-center flex-shrink-0">
        <img src="/logo-dark.png" alt="Go Green Restoration Inc" width="800" height="156" class="h-10 lg:h-12 w-auto" />
      </a>

      <!-- Desktop Navigation -->
      <div class="hidden lg:flex items-center gap-7 flex-1 justify-center">
        {navItems.map((item) => (
          <div class="relative group">
            <a
              href={item.href}
              class="text-white/90 hover:text-brand-green font-semibold uppercase tracking-wide text-xs transition-colors py-2 inline-flex items-center"
            >
              {item.label}
              {item.children && (
                <svg class="inline-block w-3 h-3 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              )}
            </a>
            {item.children && (
              <div class="absolute left-0 top-full pt-2 w-64 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200">
                <div class="bg-brand-gray-900 rounded-lg shadow-xl border border-white/10 py-2">
                  {item.children.map((child) => (
                    <a
                      href={child.href}
                      class="block px-4 py-2 text-sm text-white/80 hover:bg-white/10 hover:text-brand-green transition-colors"
                    >
                      {child.label}
                    </a>
                  ))}
                </div>
              </div>
            )}
          </div>
        ))}
      </div>

      <!-- Right CTAs -->
      <div class="hidden lg:flex items-center gap-3 flex-shrink-0">
        <a
          href="tel:+14697273217"
          class="inline-flex items-center gap-2 border border-white/30 hover:border-brand-green text-white font-bold px-5 py-2.5 rounded-full transition-colors text-sm"
        >
          <svg class="w-4 h-4 text-brand-green" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
          (469) 727-3217
        </a>
        <a
          href="/contact/"
          class="bg-brand-green hover:bg-brand-green-light text-white font-bold uppercase tracking-wide text-xs px-6 py-3 rounded-full transition-colors shadow-lg shadow-brand-green/30"
        >
          Get Free Estimate
        </a>
      </div>

      <!-- Mobile Menu Button -->
      <button
        id="mobile-menu-btn"
        class="lg:hidden p-2 text-white"
        aria-label="Toggle menu"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>

    <!-- Mobile Navigation -->
    <div id="mobile-menu" class="lg:hidden hidden mt-4 pb-4 border-t border-white/10 pt-4">
      {navItems.map((item) => (
        <div>
          <a href={item.href} class="block py-2 text-white font-semibold uppercase tracking-wide text-sm">
            {item.label}
          </a>
          {item.children && (
            <div class="pl-4">
              {item.children.map((child) => (
                <a href={child.href} class="block py-1.5 text-sm text-white/70 hover:text-brand-green">
                  {child.label}
                </a>
              ))}
            </div>
          )}
        </div>
      ))}
      <a
        href="/contact/"
        class="block mt-4 bg-brand-green text-white text-center font-bold px-6 py-3 rounded-full uppercase tracking-wide text-sm"
      >
        Get Free Estimate
      </a>
    </div>
  </nav>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => menu?.classList.toggle('hidden'));
</script>
