---
interface BreadcrumbItem {
  name: string;
  url: string;
}

interface Props {
  items: BreadcrumbItem[];
}

const { items } = Astro.props;
const siteUrl = 'https://gogreenrestorationtx.com';

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": items.map((item, index) => ({
    "@type": "ListItem",
    "position": index + 1,
    "name": item.name,
    "item": new URL(item.url, siteUrl).href,
  })),
};
---

<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

<nav aria-label="Breadcrumb" class="max-w-7xl mx-auto px-4 py-3">
  <ol class="flex flex-wrap items-center gap-1 text-sm text-brand-gray-600">
    {items.map((item, index) => (
      <li class="flex items-center gap-1">
        {index > 0 && (
          <svg class="w-3 h-3 text-brand-gray-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        )}
        {index === items.length - 1 ? (
          <span class="text-brand-gray-800 font-medium">{item.name}</span>
        ) : (
          <a href={item.url} class="hover:text-brand-brown transition-colors">
            {item.name}
          </a>
        )}
      </li>
    ))}
  </ol>
</nav>
