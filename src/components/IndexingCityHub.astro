---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import services from '../data/services.json';
import editorial from '../data/indexing-city-hubs.json';
import images from '../data/compact-service-images.json';
import {getCityGuides} from '../utils/internal-links';
import {compactServiceUrl} from '../utils/compact-city-pages';
interface Props {city:{name:string;slug:string}; nearbyCities?:{name:string;slug:string}[]}
const {city,nearbyCities=[]} = Astro.props;
const content = editorial[city.slug as keyof typeof editorial];
const image = images[content.image as keyof typeof images];
const heading = `Restoration Services in ${city.name}, Texas`;
const path = `/locations/dfw-metro/${city.slug}/`;
const guides = getCityGuides(city.slug);
const description = `Restoration services in ${city.name} for water, fire, mold, and sewage damage. Understand cleanup, affected materials, and the next steps before reconstruction.`;
---
<BaseLayout title={`Restoration Services in ${city.name}, TX | Request an Estimate | Go Green Restoration TX Inc`} description={description} omitOfficeCopy={true} schema={[{'@context':'https://schema.org','@type':'Service',name:heading,url:`https://gogreenrestorationtx.com${path}`,provider:{'@id':'https://gogreenrestorationtx.com/#organization'},areaServed:{'@type':'City',name:city.name}}]}>
  <Breadcrumbs items={[{name:'Home',url:'/'},{name:'Locations',url:'/locations/'},{name:'Dallas–Fort Worth',url:'/locations/dfw-metro/'},{name:city.name,url:path}]} />
  <article class="indexing-hub max-w-5xl mx-auto px-4 py-10 lg:py-14">
    <header>
      <h1 class="font-heading text-4xl lg:text-5xl font-extrabold mb-6">{heading}</h1>
      <p class="text-lg max-w-3xl mb-6">{content.intro}</p>
      <div class="flex flex-col sm:flex-row gap-3 mb-8"><a class="bg-brand-green text-white font-bold rounded-lg px-6 py-4 text-center" href="tel:+14697273217">Call (469) 727-3217</a><a class="bg-brand-brown text-white font-bold rounded-lg px-6 py-4 text-center" href="/contact/">Request an estimate</a></div>
      <figure class="mb-10"><img src={image.src} srcset={`${image.smallSrc} 640w, ${image.src} 1280w`} sizes="(max-width:640px) 100vw, 960px" alt={image.alt} width={image.width} height={image.height} fetchpriority="high" class="w-full rounded-xl" /><figcaption class="text-sm text-brand-gray-600 mt-2">Service illustration generated with Higgsfield; not a photograph of a completed project.</figcaption></figure>
    </header>
    <section><h2>Restoration services in {city.name}: find the right starting point</h2><ul class="grid sm:grid-cols-2 gap-x-8">{services.map(service=><li><a href={`/${service.slug}/${city.slug}/`}>{service.name} in {city.name}</a></li>)}</ul></section>
    {content.sections.map(([title,text])=><section><h2>{title}</h2><p>{text}</p></section>)}
    <section><h2>Focused help for the affected area</h2><ul>{content.focused.map(([slug,label])=><li><a href={compactServiceUrl(slug,city.slug)}>{label}</a></li>)}</ul></section>
    <section><h2>Guides for {city.name} property owners</h2><p>These articles explain the process and help you prepare for the next service decision.</p><ul>{guides.map(guide=><li><a href={`/resources/${guide.cluster}/${guide.slug}/`}>{guide.title}</a></li>)}</ul></section>
    <section><h2>Coordination for managed properties</h2><p>When residents, owners, and vendors share a property, the work also needs clear authorization and communication. Review the service that matches your role:</p><ul><li><a href={`/commercial/hoa-restoration-services/${city.slug}/`}>HOA restoration services in {city.name}</a></li><li><a href={`/commercial/property-management-restoration/${city.slug}/`}>Property management restoration in {city.name}</a></li></ul></section>
    <p class="text-sm border-t pt-6 mb-8">Go Green Restoration TX Inc welcomes mold projects of any size. While our Texas mold remediation license application is pending, work requiring a license is referred to appropriately licensed partner companies. The provider and scope of work are identified before work begins. Independent assessment and clearance are separate services.</p>
    {nearbyCities.length > 0 && <section><h2>Nearby service areas</h2><ul class="grid sm:grid-cols-2">{nearbyCities.map(nearby=><li><a href={`/locations/dfw-metro/${nearby.slug}/`}>{nearby.name}</a></li>)}</ul></section>}
    <section class="bg-brand-gray-50 p-6 rounded-xl"><h2>Discuss your property with our team</h2><p>{content.contact}</p><p>Call <a href="tel:+14697273217">(469) 727-3217</a> or <a href="/contact/">send a service request</a>.</p></section>
  </article>
</BaseLayout>
<style>
.indexing-hub section{margin-bottom:2.25rem}.indexing-hub h2{font-size:1.5rem;line-height:1.3;font-weight:700;margin-bottom:1rem;color:#1f2937}.indexing-hub p{line-height:1.8;color:#4b5563;margin-bottom:1rem}.indexing-hub section a{color:#775130;text-decoration:underline;text-underline-offset:3px}.indexing-hub ul{list-style:disc;padding-left:1.4rem;margin-bottom:1.25rem}.indexing-hub li{margin-bottom:.55rem;line-height:1.65}@media(max-width:480px){.indexing-hub h1{font-size:2.1rem}.indexing-hub h2{font-size:1.4rem}}
</style>
