---
import { isCorePathReleased, resolveCityLink } from '../utils/service-area-cities';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import services from '../data/services.json';
import topics from '../data/compact-services.json';
import images from '../data/compact-service-images.json';
import copy from '../data/expanded-main-service-copy.json';
import { compactServiceUrl } from '../utils/compact-city-pages';
interface Props {
  city: { name: string; slug: string; county: string; officialWebsite?: string };
  service: typeof services[number];
}
const {city, service} = Astro.props;
const content = copy[service.slug as keyof typeof copy];
if (!content) throw new Error(`Missing expanded city service copy: ${service.slug}`);
const heading = `${content.keyword} in ${city.name}`;
const image = images[content.image as keyof typeof images];
const related = topics.filter(item => item.parent === service.slug);
const description = `${heading}, Texas. Discuss the damage, the first visit, the proposed scope, and the next steps with Go Green Restoration TX Inc.`;
const path = `/${service.slug}/${city.slug}/`;
const draft = !isCorePathReleased(path);
const officialWebsite = city.officialWebsite && /^https:\/\//.test(city.officialWebsite) ? city.officialWebsite : undefined;
---
<BaseLayout title={`${heading} | Request an Estimate | Go Green Restoration TX Inc`} description={description} noindex={draft} omitOfficeCopy={true} schema={[{'@context':'https://schema.org','@type':'WebPage',name:heading,url:`https://gogreenrestorationtx.com${path}`,about:{'@type':'Service',name:content.keyword,areaServed:{'@type':'City',name:`${city.name}, Texas`}}}]}>
  <Breadcrumbs items={[{name:'Home',url:'/'},{name:'DFW service areas',url:'/locations/dfw-metro/'},{name:city.name,url:`/locations/dfw-metro/${city.slug}/`},{name:content.keyword,url:path}]} />
  {draft && <aside class="max-w-5xl mx-auto px-4 pt-4 text-sm text-brand-gray-600">Local review draft · not published or submitted for indexing. <a href="/city-service-preview/" class="underline">Browse city drafts</a></aside>}
  <article class="expanded-service max-w-5xl mx-auto px-4 py-10 lg:py-14">
    <header>
      <h1 class="font-heading text-4xl lg:text-5xl font-extrabold mb-6">{heading}</h1>
      <p data-uniqueness class="text-lg mb-6 max-w-3xl">{heading} {content.intro}</p>
      <div class="flex flex-col sm:flex-row gap-3 mb-8">
        <a class="bg-brand-green text-white font-bold rounded-lg px-6 py-4 text-center" href="tel:+14697273217">Call (469) 727-3217</a>
        <a class="bg-brand-brown text-white font-bold rounded-lg px-6 py-4 text-center" href="/contact/">Request an estimate</a>
      </div>
      <figure class="mb-10">
        <img src={image.src} srcset={`${image.smallSrc} 640w, ${image.src} 1280w`} sizes="(max-width:640px) 100vw, 960px" alt={image.alt} width={image.width} height={image.height} fetchpriority="high" class="w-full rounded-xl" />
        <figcaption class="text-sm text-brand-gray-600 mt-2">Higgsfield-generated service illustration; not a photograph of a completed project in {city.name}.</figcaption>
      </figure>
    </header>
    <section data-uniqueness><h2>{heading}: arranging the first visit</h2><p>Send the property address in {city.name}, a description of the affected space, and photographs if available. We will confirm current availability and an arrival estimate for the address, then explain the information needed to prepare for the visit.</p><ul>{content.checklist.map(item => <li>{item}</li>)}</ul></section>
    {content.sections.map(section => <section data-uniqueness><h2>{section.title}</h2><p>{section.text}</p></section>)}
    <section data-uniqueness><h2>What determines the estimate and timeline?</h2><p>{content.estimate}</p><p>For an occupied property, we will also discuss access, equipment placement, and which areas need to remain available to residents or staff. A manager or owner should identify who can approve the scope before work starts.</p></section>
    <section data-uniqueness><h2>Progress and the next stage of work</h2><p>{content.handoff}</p>{officialWebsite && <p>For municipal information, use the <a href={resolveCityLink(officialWebsite)}>official {city.name} website</a>. We will confirm project-specific requirements with the relevant authority as needed.</p>}</section>
    <section><h2>Help with the specific problem at your property</h2>{related.length > 0 ? <ul>{related.map(topic => <li><a href={resolveCityLink(compactServiceUrl(topic.slug,city.slug))}>{topic.name} in {city.name}</a></li>)}</ul> : <p>Reconstruction follows the agreed restoration scope. Review <a href={resolveCityLink(`/${'water-damage-restoration'}/${city.slug}/`)}>water damage restoration</a>, <a href={resolveCityLink(`/fire-smoke-damage-restoration/${city.slug}/`)}>fire and smoke cleanup</a>, or <a href={resolveCityLink(`/mold-remediation/${city.slug}/`)}>mold remediation</a> for the work that may precede repairs.</p>}<p>If moisture or affected materials raise a mold concern, see <a href={resolveCityLink(compactServiceUrl(content.moldLink,city.slug))}>the relevant mold removal process</a>.</p></section>
    {service.slug === 'mold-remediation' && <p class="text-sm text-brand-gray-600 border-t pt-6 mb-8">Go Green Restoration TX Inc welcomes mold projects of any size. While our Texas mold remediation license application is pending, work requiring a license is referred to appropriately licensed partner companies. The provider and scope of work are identified before work begins. Independent assessment and clearance are separate services.</p>}
    <section><h2>Plan the work with our team</h2><p>Call <a href="tel:+14697273217">(469) 727-3217</a> or <a href="/contact/">send a service request</a>. We will discuss the problem, current condition, and access to your {city.name} property.</p><p>See our <a href={resolveCityLink(`/services/${service.slug}/`)}>{service.name.toLowerCase()} overview</a> for the broader service scope or return to <a href={resolveCityLink(`/locations/dfw-metro/${city.slug}/`)}>restoration services in {city.name}</a>.</p></section>
  </article>
</BaseLayout>
<style>
  .expanded-service section{margin-bottom:2.25rem}.expanded-service h2{font-size:1.5rem;line-height:1.3;font-weight:700;margin-bottom:1rem;color:#1f2937}.expanded-service p{line-height:1.8;color:#4b5563;margin-bottom:1rem}.expanded-service section a{color:#775130;text-decoration:underline;text-underline-offset:3px}.expanded-service ul{list-style:disc;padding-left:1.4rem;margin-bottom:1.25rem}.expanded-service li{margin-bottom:.55rem;line-height:1.65}@media(max-width:480px){.expanded-service h1{font-size:2.1rem}.expanded-service h2{font-size:1.4rem}}
</style>
